# ============================================================
# AI Fund Platform — Environment Configuration
# Copy to .env for local development. Do not commit real secrets.
# ============================================================

# ---- App runtime ----
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info
MIGRATIONS_PATH=migrations
STATIC_FILES_PATH=web/dist
SESSION_TTL=12h

# ---- PostgreSQL ----
# Host-native server runs should use localhost.
# Containerized app runs use APP_DATABASE_URL and default to the compose hostname `postgres`.
# Same-host Compose production can keep postgres:5432 with APP_DATABASE_SSLMODE=disable only when ALLOW_INTERNAL_COMPOSE_DB=1.
# Later, move DB off-host by replacing APP_DATABASE_URL with an external PostgreSQL URL and APP_DATABASE_SSLMODE=require or verify-full.
POSTGRES_USER=fundai
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=fundai
POSTGRES_PORT=5432
DATABASE_URL=postgres://fundai:local_dev_only_change_me@localhost:5432/fundai?sslmode=disable
APP_DATABASE_URL=postgres://fundai:local_dev_only_change_me@postgres:5432/fundai?sslmode=disable
APP_DATABASE_SSLMODE=disable
ALLOW_INTERNAL_COMPOSE_DB=0
# Legacy DB_* vars are still supported when DATABASE_URL is unset.
DB_HOST=localhost
DB_PORT=5432
DB_USER=fundai
DB_PASSWORD=local_dev_only_change_me
DB_NAME=fundai
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# ---- Security ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=change_me_to_a_random_64_char_string_min_32_chars
MODEL_CONFIG_API_KEY_SECRET=change_me_to_a_random_64_char_string_min_32_chars_model_cfg

# ---- Default LLM (recommended single env-first path) ----
# If team agents do not have individual model config, they inherit these defaults.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Optional tier-specific overrides. Leave blank to inherit the global LLM_* values above.
# Example: set LLM_CRITICAL_MODEL=gpt-4o only if you want critical steps to differ from the global default.
LLM_CRITICAL_PROVIDER=
LLM_CRITICAL_MODEL=
LLM_CRITICAL_BASE_URL=
LLM_CRITICAL_API_KEY=

LLM_STANDARD_PROVIDER=
LLM_STANDARD_MODEL=
LLM_STANDARD_BASE_URL=
LLM_STANDARD_API_KEY=

LLM_SIMPLE_PROVIDER=
LLM_SIMPLE_MODEL=
LLM_SIMPLE_BASE_URL=
LLM_SIMPLE_API_KEY=

# ---- Provider-specific aliases (optional fallback / alternate style) ----
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

CLAUDE_MODEL=
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_API_KEY=
# Anthropic aliases are also supported.
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

QWEN_MODEL=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
# Google aliases are also supported.
GOOGLE_MODEL=
GOOGLE_BASE_URL=
GOOGLE_API_KEY=

# To use Gemini native generateContent as the default provider:
# LLM_PROVIDER=gemini
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=
# Then fill GEMINI_MODEL / GEMINI_BASE_URL / GEMINI_API_KEY above.

# ---- Market data ----
# Fill at least one quote provider URL to enable live quote snapshots.
# Troubleshooting: if Decision Center shows "当前报价不可用，执行前需要重新刷新价格",
# see README "决策中心提示『当前报价不可用，执行前需要重新刷新价格』" for the full checklist
# (open hours, provider list, MCP URLs, timeout/TTL).
MARKETDATA_QUOTE_PROVIDERS=quantdinger,china-stock,akshare
# Per-market quote provider overrides (F1.5). When set, the listed market uses
# this chain instead of MARKETDATA_QUOTE_PROVIDERS — the global list and the
# built-in default chain are still appended at the tail (deduped) so a missing
# fallback can never leak through. Recommended baseline:
#   - cnstock: tencent first (no auth, fast), akshare for fundamentals fallback
#   - usstock: yahoo v8 (keyless, no Polygon needed)
#   - futures: akshare first (SHFE/DCE/CZCE/INE 主力合约), yahoo fallback for global (GC=F etc.)
#   - crypto:  coingecko first (keyless, 30 req/min free), yahoo for BTC-USD majors
# MARKETDATA_QUOTE_PROVIDERS_CNSTOCK=tencent,akshare
# MARKETDATA_QUOTE_PROVIDERS_USSTOCK=yahoo
# MARKETDATA_QUOTE_PROVIDERS_FUTURES=akshare,yahoo
# MARKETDATA_QUOTE_PROVIDERS_CRYPTO=coingecko,yahoo
# CoinGecko base URL. Leave empty to use the public, key-less v3 endpoint
# (https://api.coingecko.com/api/v3). Override only if you have a CoinGecko
# Pro key (point this at a reverse proxy that injects the Authorization
# header) or want to mock CoinGecko in tests.
MARKETDATA_COINGECKO_BASE_URL=

# ---- Crypto WebSocket streams (F8) ----
# Real-time tick data for crypto is sourced from Binance and Coinbase public
# websocket feeds (both free, no API key). Each stream maintains an in-memory
# ticker cache; the `binance` / `coinbase` quote providers serve from cache
# in microseconds and fall back to CoinGecko / Yahoo when the cache misses.
# Set MARKETDATA_CRYPTO_WS_ENABLED=false to disable WS entirely and rely on
# polling only (CoinGecko's 30 req/min free quota will become the bottleneck).
MARKETDATA_CRYPTO_WS_ENABLED=true
# Override the websocket endpoints (empty uses the public defaults).
# Default Binance: wss://data-stream.binance.vision/ws
# Default Coinbase: wss://ws-feed.exchange.coinbase.com
MARKETDATA_BINANCE_WS_URL=
MARKETDATA_COINBASE_WS_URL=
# Comma-separated subscription lists. Empty uses the built-in seed lists
# (top-25 USDT pairs on Binance, top-20 USD pairs on Coinbase). Use the
# native symbol format: Binance BTCUSDT, Coinbase BTC-USD. The Coinbase
# normaliser also accepts join form (BTCUSD → BTC-USD) for convenience.
MARKETDATA_BINANCE_WS_SYMBOLS=
MARKETDATA_COINBASE_WS_PRODUCTS=
# How old a cached WS ticker may be before the WS provider returns
# "unavailable" and the chain falls through to CoinGecko / Yahoo. Binance
# publishes 24hrTicker every ~1s per symbol when liquidity is active so
# the default 30s leaves wide headroom for transient disconnects.
MARKETDATA_CRYPTO_WS_STALE_AFTER=30s
# NOTE on connectivity: Binance + Coinbase market-data endpoints are
# regionally blocked from some networks (notably Mainland China). On those
# hosts the TLS handshake may succeed but the ticker stream is silently
# dropped — the provider tracker will show binance-ws / coinbase-ws as
# connected (ok=1) yet the cache remains empty. Two options:
#   1) Deploy in a region with unrestricted access (HK / SG / Tokyo / EU / US)
#   2) Set MARKETDATA_CRYPTO_WS_ENABLED=false and accept CoinGecko's 30 req/min
#      polling cadence as the only crypto price source. The chain auto-falls
#      back to CoinGecko + Yahoo when the WS cache is empty/stale, so leaving
#      WS enabled never breaks anything — it just won't help in restricted
#      regions.
# News providers (priority left-to-right). For A-share instruments the service
# also auto-prepends eastmoney + sina (keyless, Chinese-native) before the
# providers listed here, so non-A-share markets are unaffected.
MARKETDATA_NEWS_PROVIDERS=eastmoney,sina,local-search,web-search
MARKETDATA_QUOTE_TTL=10s
MARKETDATA_NEWS_TTL=2m
MARKETDATA_PROVIDER_TIMEOUT=5s

# ---- Market data resilience (phase 3a) ----
# Quote is flagged with isStale=true (and surfaced as a research note) when
# its AsOf timestamp is older than this threshold. The Decision Center uses
# this signal to warn before executing on an outdated price.
MARKETDATA_STALE_AFTER=15m
# Per-provider circuit breaker: after this many consecutive failures the
# provider is skipped for MARKETDATA_CIRCUIT_COOLDOWN before being retried.
# A single success closes the circuit back.
MARKETDATA_CIRCUIT_FAILURES=3
MARKETDATA_CIRCUIT_COOLDOWN=30s
# Adaptive news TTL: shrink/expand the news cache window based on whether any
# major market is currently in session. Set to false to always use NEWS_TTL.
MARKETDATA_ADAPTIVE_TTL=true

# Optional base URL overrides for the keyless A-share news providers
# (useful for self-hosted proxies or integration tests).
EASTMONEY_NEWS_BASE_URL=
SINA_NEWS_BASE_URL=

# Hybrid news aggregation runs the Chinese-leaning and English-leaning
# provider chains in parallel and merges/dedupes the result, so users see
# native A-share coverage alongside English macro context (and vice versa
# for US instruments). Set to false to fall back to the legacy single-chain
# behaviour (useful for debugging cost spikes).
MARKETDATA_NEWS_HYBRID=true

# Optional news translator. Pick one of:
#   none           - no translation (default; frontend only shows the source language)
#   libretranslate - keyless or API-key based, OSS engine (https://libretranslate.com)
#   openai-compat  - any OpenAI-compatible /chat/completions endpoint (DeepSeek, OpenAI,
#                    Qwen-compat, local LLM, etc.). Requires MARKETDATA_TRANSLATOR_MODEL.
# When configured, the translator fills missing titleZh/titleEn/summaryZh/summaryEn
# fields so each news item is renderable in both languages regardless of source.
MARKETDATA_TRANSLATOR_PROVIDER=none
MARKETDATA_TRANSLATOR_BASE_URL=
MARKETDATA_TRANSLATOR_API_KEY=
MARKETDATA_TRANSLATOR_MODEL=
MARKETDATA_TRANSLATOR_TIMEOUT=8s

# Optional quote provider only.
QUANTDINGER_URL=
MCP_CHINA_STOCK_URL=
MCP_AKSHARE_URL=
MCP_TA_LIB_URL=
# For docker compose app runs, the compose file defaults this to http://web-search-mcp:3004.
# For host-native backend runs, set this to http://localhost:3004 after starting docker compose up -d --build web-search-mcp.
MCP_WEB_SEARCH_URL=
# Host port and upstream RSS/search feed used by the local web-search-mcp container.
WEB_SEARCH_MCP_PORT=3004
WEB_SEARCH_FEED_URL=https://news.google.com/rss/search

# ---- Search / news provider keys ----
# local-search, serpapi, and tavily can run directly without deploying QuantDinger.
SERPAPI_KEYS=
TAVILY_API_KEYS=
# Optional base URL overrides for self-hosted/proxy setups or tests.
SERPAPI_BASE_URL=
TAVILY_BASE_URL=
