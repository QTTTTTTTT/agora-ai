# ============================================================
# AI Fund Platform — Environment Configuration
# ------------------------------------------------------------
# 复制到 .env 后再编辑：cp .env.example .env
# 千万不要提交真实密钥到仓库。
#
# 必填 (本地起步) ── 这 4 个配齐就能跑起来：
#   1) DATABASE_URL                  数据库地址（容器内用 APP_DATABASE_URL）
#   2) JWT_SECRET                    至少 32 字符的随机串
#   3) MODEL_CONFIG_API_KEY_SECRET   独立于 JWT 的 32+ 字符随机串
#   4) LLM_PROVIDER + LLM_MODEL + LLM_API_KEY  默认 LLM (或挑一个 *_API_KEY 别名)
#
# 推荐再补：
#   - 至少一个市场数据源 (QUANTDINGER_URL 或 MCP_*_URL 或公网默认链)
#   - 至少一个新闻源 (SERPAPI_KEYS / TAVILY_API_KEYS / 自带 eastmoney+sina)
#
# 生产前必看：CORS_ORIGINS、APP_PUBLIC_URL、APP_DATABASE_SSLMODE、APP_ENV
# 详见 README 「生产部署前检查」与「.env.example 配置说明」两节。
# ============================================================

# =============================================================
# 1. 应用运行时 ──────────────────────────────────────────────
# =============================================================

# APP_ENV       development | production；production 会触发额外配置校验。
# APP_PORT      监听端口；SERVER_PORT 是历史别名。
# LOG_LEVEL     debug | info | warn | error。
# MIGRATIONS_PATH / STATIC_FILES_PATH  迁移文件与前端构建产物的相对路径，
#               同时支持 MIGRATIONS_DIR / STATIC_DIR 旧名。
# SESSION_TTL   登录会话有效期；过期后强制重新登录。
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info
MIGRATIONS_PATH=migrations
STATIC_FILES_PATH=web/dist
SESSION_TTL=12h

# Docker compose 内部默认 RUNNING_IN_CONTAINER=1 + ALLOW_INTERNAL_COMPOSE_DB=1
# 才允许 DATABASE_URL 指向 compose 内部主机名 postgres。生产部署千万别开。
ALLOW_INTERNAL_COMPOSE_DB=0


# =============================================================
# 2. PostgreSQL ──────────────────────────────────────────────
# =============================================================
# 单一可信地址：DATABASE_URL。所有 server 进程优先读这个。
#   * Host-native: 用 localhost:5432。
#   * 容器内: 优先 APP_DATABASE_URL（compose 帮你转 postgres:5432）。
#   * 老式 DB_HOST/DB_PORT/... 仅在 DATABASE_URL 为空时回退使用。
#
# 生产硬条件：
#   - DATABASE_URL 不能指向 localhost / 127.0.0.1
#   - 不能使用 sslmode=disable
#   - 不能继续用 demo/placeholder 凭据
POSTGRES_USER=fundai
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=fundai
POSTGRES_PORT=5432
DATABASE_URL=postgres://fundai:local_dev_only_change_me@localhost:5432/fundai?sslmode=disable
APP_DATABASE_URL=postgres://fundai:local_dev_only_change_me@postgres:5432/fundai?sslmode=disable
APP_DATABASE_SSLMODE=disable

# Legacy 回退（DATABASE_URL 为空时使用）
DB_HOST=localhost
DB_PORT=5432
DB_USER=fundai
DB_PASSWORD=local_dev_only_change_me
DB_NAME=fundai
DB_SSL_MODE=disable

# 连接池
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m


# =============================================================
# 3. 安全 / 密钥 ──────────────────────────────────────────────
# =============================================================
# JWT_SECRET                       签发 / 校验登录 token，必须 >= 32 字符
# JWT_SECRETS_JSON                 多 key 轮换；与 JWT_SECRET 二选一即可
#                                  示例：[{"kid":"k2","secret":"...","active":true},{"kid":"k1","secret":"..."}]
# MODEL_CONFIG_API_KEY_SECRET      加密用户存进 DB 的第三方模型 API key
#                                  生产必须独立于 JWT_SECRET，且 >= 32
# API_KEY_ENCRYPTION_SECRET        历史别名，未设 MODEL_CONFIG_API_KEY_SECRET 时
#                                  回退到这里读
# CORS_ORIGINS                     逗号分隔的允许跨域来源；生产必须替换为
#                                  真实 HTTPS 站点，禁用 *、localhost、127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=change_me_to_a_random_64_char_string_min_32_chars
# JWT_SECRETS_JSON=[]
MODEL_CONFIG_API_KEY_SECRET=change_me_to_a_random_64_char_string_min_32_chars_model_cfg
# API_KEY_ENCRYPTION_SECRET=

# P0-6 — TOTP / 2FA secret-at-rest encryption key
# 64-character hex string (= 32 raw bytes for AES-256-GCM). When this
# variable is unset OR malformed the 2FA endpoints register as 404 so
# clients degrade gracefully — no plaintext secrets are ever written.
# Generate with: openssl rand -hex 32
# TOTP_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# P0-9 — Live trading hard gate kill switch
# Default true. When set to "false", funds with trading_mode='live'
# bypass the four-pillar check (KYC + broker_link + 2FA + step-up)
# and behave like simulation funds. Use ONLY in dev / smoke setups.
# Production deploys MUST keep this unset (default true) or
# explicitly set to "true". The startup log emits a WARN when the
# gate is off so an operator can spot a misconfigured prod box.
# LIVE_TRADING_GATE_ENABLED=true


# =============================================================
# 4. 站点公开地址 / 品牌 ─────────────────────────────────────
# =============================================================
# APP_PUBLIC_URL  前端实际公网地址。Password reset / verify-email 邮件
#                 模板的链接前缀都来自这里。
# BRAND_NAME      邮件模板里的产品名占位符。
APP_PUBLIC_URL=http://localhost:5173
BRAND_NAME=FundAI


# =============================================================
# 5. SMTP / 事务邮件 ─────────────────────────────────────────
# =============================================================
# SMTP_HOST 留空时邮件 handler 进入 "in-memory recorder" 模式：把
# verification 邮件正文（含 6 位 code 或 reset 链接）直接返回到 JSON
# response 里，方便本地一站式跑完 onboarding 流程。
#
# 生产推荐：
#   * 中国大陆：阿里云 DM (dm.console.aliyun.com) 或 腾讯云 SES
#   * 全球：    SendGrid / Postmark / Amazon SES
#   * Dev:      MailHog -> docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
#               SMTP_HOST=localhost SMTP_PORT=1025 SMTP_STARTTLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=FundAI
SMTP_USE_TLS=false
SMTP_STARTTLS=true
SMTP_TIMEOUT=15s


# =============================================================
# 6. 微信小程序登录 ─────────────────────────────────────────
# =============================================================
# 来源：mp.weixin.qq.com → 设置 → 开发设置。
# 留空时 /api/auth/wechat-login 返回 503，小程序自动 fall back 到
# 邮箱/密码登录（不会卡用户）。详见 docs/MINIAPP_DEPLOYMENT.md。
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=
WECHAT_JSCODE_SESSION_URL=
WECHAT_LOGIN_TIMEOUT=8s


# =============================================================
# 7. 默认 LLM（env-first 推荐入口）─────────────────────────────
# =============================================================
# 优先级：请求显式模型 > agent 单独配置 > 用户 tier 覆盖 > tier .env
# 默认 > 全局 LLM_* > 代码内置兜底。所以这里写一组就够基础启动。
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Tier 覆盖（关键步骤 / 标准 / 简单）。留空 = 继承全局 LLM_*。
LLM_CRITICAL_PROVIDER=
LLM_CRITICAL_MODEL=
LLM_CRITICAL_BASE_URL=
LLM_CRITICAL_API_KEY=

LLM_STANDARD_PROVIDER=
LLM_STANDARD_MODEL=
LLM_STANDARD_BASE_URL=
LLM_STANDARD_API_KEY=

LLM_SIMPLE_PROVIDER=
LLM_SIMPLE_MODEL=
LLM_SIMPLE_BASE_URL=
LLM_SIMPLE_API_KEY=


# =============================================================
# 8. 第三方 provider 原生别名（可选 fallback）──────────────────
# =============================================================
# 这些是 LLM_* 缺一项时的 fallback；填写格式与 provider 文档一致。
# 也可以直接当主入口：把 LLM_PROVIDER 设成对应 provider，然后只填这里。
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

CLAUDE_MODEL=
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

QWEN_MODEL=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# Gemini 原生 generateContent 协议（不是 OpenAI 兼容）：
#   LLM_PROVIDER=gemini
#   LLM_MODEL=  (留空，下面 GEMINI_MODEL 生效)
#   LLM_BASE_URL=  (留空，使用 .../v1beta)
#   LLM_API_KEY=  (留空，使用下面 GEMINI_API_KEY)
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GOOGLE_MODEL=
GOOGLE_BASE_URL=
GOOGLE_API_KEY=


# =============================================================
# 9. L3 记忆 embedding (recall) ─────────────────────────────
# =============================================================
# 给 memories 表做 pgvector 向量化的 backfill worker 用。
#   * RECALL_OPENAI_API_KEY 为空 → loop 不启动（功能软关）。
#   * 没填时会自动 fallback 到 OPENAI_API_KEY / OPENAI_BASE_URL。
RECALL_OPENAI_API_KEY=
RECALL_OPENAI_BASE_URL=
RECALL_EMBED_MODEL=text-embedding-3-small


# =============================================================
# 10. 行情链路 / 报价 provider ───────────────────────────────
# =============================================================
# 排查 "当前报价不可用，执行前需要重新刷新价格"：见 README 末尾的
# "常见问题排查" 一节。最短路径：保留默认链 + 启动需要的 MCP 容器。
#
# 全局 fallback 链（左 → 右），任一市场未单独覆盖时使用：
MARKETDATA_QUOTE_PROVIDERS=quantdinger,china-stock,akshare

# 各市场链覆盖 (F1.5)。设置则该市场用此列表覆盖全局，且全局链与默认链
# 仍会在末尾去重追加，确保 fallback 永远存在。基线建议：
#   - cnstock: tencent → china-stock → akshare（前两者免 key）
#   - usstock: yahoo Chart v8（免 key）
#   - futures: akshare → yahoo（akshare 覆盖 SHFE/DCE/CZCE/INE 主力，yahoo 兜底全球）
#   - crypto:  binance → coinbase → coingecko → yahoo（前两者来自后台 WS 推流）
# MARKETDATA_QUOTE_PROVIDERS_CNSTOCK=tencent,akshare
# MARKETDATA_QUOTE_PROVIDERS_USSTOCK=yahoo
# MARKETDATA_QUOTE_PROVIDERS_FUTURES=akshare,yahoo
# MARKETDATA_QUOTE_PROVIDERS_CRYPTO=binance,coinbase,coingecko,yahoo

# CoinGecko base URL。空 = 走公网免 key v3（30 req/min 免费配额）。
# 有 Pro key 时把这里指向自建反代（由反代注入 Authorization 头），
# 不要把 key 直接暴露给客户端。
MARKETDATA_COINGECKO_BASE_URL=

# QuantDinger（如自建）作为 quote 优先源；空 = 跳过。
QUANTDINGER_URL=

# A 股 MCP。默认指向 docker compose service 名；host 直跑 server 时
# 改成 http://localhost:3001 / :3002 并 docker compose --profile
# market-data up -d 起对应容器。
MCP_CHINA_STOCK_URL=http://china-stock-mcp:3001
MCP_AKSHARE_URL=http://akshare-mcp:3002
MCP_TA_LIB_URL=

# 单 akshare 容器处理所有 akshare-backed 读取；如需分离 OHLC/基本面/板块
# 资金流，把下面三项分别指到不同上游即可。
AKSHARE_OHLC_URL=http://akshare-mcp:3002
AKSHARE_FUNDAMENTAL_URL=http://akshare-mcp:3002
AKSHARE_SECTORFLOW_URL=http://akshare-mcp:3002

# Binance 公网 OHLC（与下面的 WS 不同，这是历史 K 线 REST）；空 = 默认。
BINANCE_OHLC_URL=

# East Money OHLC：keyless 上游，主要用于 A 股指数（chinext / star50 /
# csi500 等 Yahoo 上游 firstTradeDate=null 的标的）。默认启用；如需在
# 隔离环境（无外网或被防火墙拦截 push2his.eastmoney.com）禁用，置
# EASTMONEY_OHLC_DISABLED=1。EASTMONEY_OHLC_URL 留空即用官方主机；
# 仅在自建反代 / 测试 stub 时填写。
EASTMONEY_OHLC_DISABLED=
EASTMONEY_OHLC_URL=

# ---------- A/B 影子运行（Card K-1）----------
# AnalyzeTest 触发时，B 变体的每笔影子交易决策默认走「确定性」
# 路径——即按 strategy_config 算一个 trade_scale 后机械缩放 A 组
# 的真实交易。打开 AB_SHADOW_LLM_ENABLED=1 后，会改为对每笔 A
# 交易单独询问 LLM「以 B 的 strategy_config 来看，B 会怎么做」
# 并解析 JSON 决策；run 结束时再做一次整体学习总结。
#
# - 任意 LLM/解析错误会自动回退到确定性路径，不会让 AnalyzeTest
#   失败。
# - AB_SHADOW_LLM_MAX_CALLS：每次 AnalyzeTest 最多调多少次 LLM
#   （默认 50）。超出后该笔自动回退到确定性。
# - AB_SHADOW_LLM_MODEL：可选的具体模型名（覆盖 tier）；留空时
#   走 standard tier。
# - AB_SHADOW_LLM_TIMEOUT_SEC：单次 LLM 调用的超时（默认 12s）。
AB_SHADOW_LLM_ENABLED=
AB_SHADOW_LLM_MAX_CALLS=
AB_SHADOW_LLM_MODEL=
AB_SHADOW_LLM_TIMEOUT_SEC=

# 各类数据缓存 TTL（节流 + 避免上游 ban）
OHLC_CACHE_TTL=15m
FUNDAMENTAL_CACHE_TTL=24h
SECTORFLOW_CACHE_TTL=10m

# Yahoo Finance 财报日历
YAHOO_EARNINGS_BASE_URL=
YAHOO_EARNINGS_CONCURRENCY=4

# Web-search MCP (Compose 内置 web-search-mcp 容器)
# - 容器内的 app 默认会读 http://web-search-mcp:3004
# - host 直跑时改成 http://localhost:3004
MCP_WEB_SEARCH_URL=
WEB_SEARCH_MCP_PORT=3004
WEB_SEARCH_FEED_URL=https://news.google.com/rss/search


# =============================================================
# 11. Crypto WebSocket 实时推流 (F8) ─────────────────────────
# =============================================================
# Binance + Coinbase 两条免 key 公网 WS，进程内 ticker cache 微秒返回。
# 关闭后只剩 CoinGecko / Yahoo 轮询（30 req/min 免费配额会成瓶颈）。
MARKETDATA_CRYPTO_WS_ENABLED=true
# 默认 Binance: wss://data-stream.binance.vision/ws
# 默认 Coinbase: wss://ws-feed.exchange.coinbase.com
MARKETDATA_BINANCE_WS_URL=
MARKETDATA_COINBASE_WS_URL=
# 逗号分隔订阅列表；空 = 使用内置 seed（Binance 25 个 USDT 对、Coinbase
# 22 个 USD 对）。Binance 用 BTCUSDT；Coinbase 用 BTC-USD（也接受 BTCUSD）。
MARKETDATA_BINANCE_WS_SYMBOLS=
MARKETDATA_COINBASE_WS_PRODUCTS=
# 缓存 ticker 多久内有效；超过则 WS provider 退回到 CoinGecko/Yahoo。
MARKETDATA_CRYPTO_WS_STALE_AFTER=30s
#
# 网络可达性提示：Binance + Coinbase 市场数据端点在某些区域（如中国大陆
# 公网）会被静默丢包 —— TLS 握手成功但 ticker stream 不推。两个选项：
#   1) 部署到无限制区域（HK / SG / Tokyo / EU / US）
#   2) MARKETDATA_CRYPTO_WS_ENABLED=false，接受 CoinGecko 30 req/min 轮询节奏
# 链路自带 fallback，WS 不通永远不会让请求失败，只是省不了 REST 调用。


# =============================================================
# 12. 新闻 provider ─────────────────────────────────────────
# =============================================================
# A 股标的会自动在前面追加 eastmoney + sina（免 key，中文原生）。
MARKETDATA_NEWS_PROVIDERS=eastmoney,sina,local-search,web-search

# hybrid: ZH 与 EN 两条 provider 链并发拉取 + 合并去重，让用户同时看到
# 本地中文报道与英文宏观/分析师视角。设为 false 回到传统单链 fallback。
MARKETDATA_NEWS_HYBRID=true

# 自建/反代 eastmoney + sina 时填入；空 = 走官方 base URL。
EASTMONEY_NEWS_BASE_URL=
SINA_NEWS_BASE_URL=

# 第三方搜索/新闻聚合 API key（local-search / web-search 不需要）。
# 多个 key 用逗号分隔，server 端会做轮询配额分摊。
SERPAPI_KEYS=
TAVILY_API_KEYS=
SERPAPI_BASE_URL=
TAVILY_BASE_URL=


# =============================================================
# 13. 新闻翻译（可选）────────────────────────────────────────
# =============================================================
# 把 hybrid 拉到的中文/英文新闻补齐为另一种语言。
# Provider:
#   none           不翻译（默认）
#   libretranslate 调用 LibreTranslate 兼容服务（开源）
#   openai-compat  调用任意 OpenAI 兼容 /chat/completions（DeepSeek / OpenAI /
#                  Qwen-compat / 本地 LLM），需要同时填 *_MODEL
MARKETDATA_TRANSLATOR_PROVIDER=none
MARKETDATA_TRANSLATOR_BASE_URL=
MARKETDATA_TRANSLATOR_API_KEY=
MARKETDATA_TRANSLATOR_MODEL=
MARKETDATA_TRANSLATOR_TIMEOUT=8s


# =============================================================
# 14. 行情韧性 / 缓存 / 风控 (Phase 3a/3c) ───────────────────
# =============================================================
# QuoteSnapshot.AsOf 超过 STALE_AFTER → isStale=true；硬风控的
# StaleQuoteGuard 会因此 reject "买入/加仓/开空" 但放行 "卖出/平仓"。
MARKETDATA_STALE_AFTER=15m

# 单 provider 连续失败 CIRCUIT_FAILURES 次 → 熔断 CIRCUIT_COOLDOWN
# 再试。单次成功立即关熔断。429 单独走 THROTTLE_COOLDOWN 防止打爆配额。
MARKETDATA_CIRCUIT_FAILURES=3
MARKETDATA_CIRCUIT_COOLDOWN=30s
MARKETDATA_THROTTLE_COOLDOWN=5m

# 自适应 TTL：根据"主要市场是否开盘"动态收缩/放大缓存窗口。
MARKETDATA_ADAPTIVE_TTL=true
MARKETDATA_ADAPTIVE_QUOTE_TTL=true
MARKETDATA_QUOTE_TTL_INSESSION=5s
MARKETDATA_QUOTE_TTL_OFFSESSION=60s

# 默认 TTL（关掉自适应时也用）+ 上游超时
MARKETDATA_QUOTE_TTL=10s
MARKETDATA_NEWS_TTL=2m
MARKETDATA_PROVIDER_TIMEOUT=5s

# 上游限速白名单。格式："name=req/sec[,name=req/sec...]"
# 例: MARKETDATA_QUOTE_RATE_LIMITS=coingecko=0.5,yahoo=4
MARKETDATA_QUOTE_RATE_LIMITS=


# =============================================================
# 15. Feature flags / debug ─────────────────────────────────
# =============================================================
# 圆桌讨论模式（多 agent 轮发言）。"on" / "true" / "1" 打开，默认 off。
FUND_DEBATE_ROUNDTABLE=

# 关闭回测引擎（CI / 演示环境用）。"1" / "true" 关闭。
BACKTEST_DISABLED=

# Sprint 9.3 — Social sentiment ingestion (Xueqiu / StockTwits /
# Reddit-WSB). Each provider is OFF by default; the workflow's
# sentiment block sees news-only items unless the global
# kill-switch AND at least one per-provider flag are set.
SOCIAL_PROVIDERS_ENABLED=
SOCIAL_PROVIDER_XUEQIU=
SOCIAL_XUEQIU_GUEST_TOKEN=
SOCIAL_PROVIDER_STOCKTWITS=
SOCIAL_STOCKTWITS_ACCESS_TOKEN=
SOCIAL_PROVIDER_REDDIT=
SOCIAL_REDDIT_MIN_UPVOTES=
SOCIAL_REDDIT_USER_AGENT=

# Sprint 9.4 — Three-stage decision pipeline. When ON, the PM
# decision is split into Trader.Propose → Risk.Assess →
# PM.FinalApprove, each as its own LLM call. The PM (final) stage
# stays on TierCritical via the inner engine; the trader and
# risk stages default to TierStandard but can be downgraded to
# "simple" for cost amortisation, or upgraded to "critical".
PM_THREE_STAGE_DECISION=
PM_THREE_STAGE_PROPOSAL_TIER=
PM_THREE_STAGE_ASSESSMENT_TIER=
