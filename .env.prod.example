# ============================================================
# AI Fund Platform — PRODUCTION Environment Template
# ------------------------------------------------------------
# 复制：cp .env.prod.example .env (在生产部署节点)
# 然后逐项填入；空值或保留占位符的项必须替换。
#
# 与 .env.example 的关系
#   * .env.example  —— 完整 dev 模板，含弱默认值（local_dev_only_change_me、
#                     change_me_to_a_random_64_char_string 等），让本地一行
#                     `cp` 就能跑起来。
#   * .env.prod.example (本文件) —— 生产模板。**没有可以直接 copy-and-go
#                     的弱默认值**；任何 secret 都必须由部署者明确生成、
#                     从 secrets manager 注入。docker-compose.prod.yml 里
#                     用 `${VAR:?...}` 强制 fail-fast；这里把"为什么"写清楚。
#
# 强制硬条件（启动时由 server/cmd/server/main.go validateConfig 校验）
#   * APP_ENV = production
#   * DATABASE_URL 必须 sslmode=require 或 verify-full（off-host DB）
#                   或 sslmode=disable + ALLOW_INTERNAL_COMPOSE_DB=1
#                   （same-host compose，且 host 段为 'postgres' 服务名）
#   * JWT_SECRET, MODEL_CONFIG_API_KEY_SECRET ≥ 32 char 真随机串，必须互不相等
#   * CORS_ORIGINS 必须为 https:// 真实域名列表，不允许 *、localhost、127.0.0.1
#   * 不允许 demo / placeholder / change_me 字样的凭据
# ============================================================

# =============================================================
# 1. 应用运行时
# =============================================================
APP_ENV=production
APP_PORT=8080
LOG_LEVEL=info
MIGRATIONS_PATH=migrations
STATIC_FILES_PATH=web/dist
SESSION_TTL=12h

# secure-by-default：sslmode=disable 仅在 same-host compose 时由部署者
# 显式置 1。off-host RDS / Aurora / 自建 Postgres 务必保持 0 + URL 用 require。
ALLOW_INTERNAL_COMPOSE_DB=0

# =============================================================
# 2. PostgreSQL
# =============================================================
# 要求：sslmode=require 或 verify-full。off-host 必填。
# 不允许 localhost / 127.0.0.1。
# 不允许 demo / placeholder 凭据。
# DATABASE_URL=postgres://USER:STRONG_PASSWORD@db.example.com:5432/fundai?sslmode=require
DATABASE_URL=
# APP_DATABASE_URL 仅在 same-host compose 部署时才用 service 名 'postgres'。
# off-host 部署留空，由 server 直接读 DATABASE_URL。
APP_DATABASE_URL=
APP_DATABASE_SSLMODE=require

POSTGRES_USER=
# 由 docker-compose.prod.yml 的 ${POSTGRES_PASSWORD:?...} 强制要求。
POSTGRES_PASSWORD=
POSTGRES_DB=fundai
POSTGRES_PORT=5432

# 连接池：根据负载调，默认 25/10/5m 适合 4 vCPU app + db.r6g.large。
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# =============================================================
# 3. 安全 / 密钥
# =============================================================
# 生成：openssl rand -hex 32
# 必须互不相等；JWT_SECRET 与 MODEL_CONFIG_API_KEY_SECRET 用途不同的人为
# 隔离让一处泄漏不至于同时绕过身份与凭据保护。
JWT_SECRET=
# JWT_SECRETS_JSON 是 JWT_SECRET 的多 key 轮换形态，二选一。
# JWT_SECRETS_JSON=[{"kid":"k2","secret":"...","active":true},{"kid":"k1","secret":"..."}]
MODEL_CONFIG_API_KEY_SECRET=

# 64-char hex（32 byte AES-256-GCM key）。openssl rand -hex 32。
# 留空 = 2FA endpoints 返回 404，客户端自动降级（无明文落库风险）。
TOTP_ENCRYPTION_KEY=

# 默认 true。生产 must keep true / 不设置。设 false 仅用于 dev / smoke。
LIVE_TRADING_GATE_ENABLED=true

# CORS 允许列表 — 必须 https:// 真实域名。
# CORS_ORIGINS=https://app.example.com,https://www.example.com
CORS_ORIGINS=

# =============================================================
# 4. 站点公开地址 / 品牌
# =============================================================
# 真实公网 https URL。用于密码重置 / 邮箱验证邮件链接前缀。
# APP_PUBLIC_URL=https://app.example.com
APP_PUBLIC_URL=
BRAND_NAME=FundAI

# =============================================================
# 5. SMTP / 事务邮件
# =============================================================
# 留空 = 邮件 handler 进入 in-memory recorder 模式（仅 dev）。
# 生产强烈建议接真实 SMTP；中国大陆推荐阿里云 DM / 腾讯云 SES，全球
# 推荐 SendGrid / Postmark / Amazon SES。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=FundAI
SMTP_USE_TLS=false
SMTP_STARTTLS=true
SMTP_TIMEOUT=15s

# =============================================================
# 6. 微信小程序登录（可选）
# =============================================================
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=
WECHAT_JSCODE_SESSION_URL=
WECHAT_LOGIN_TIMEOUT=8s

# =============================================================
# 7. LLM
# =============================================================
# 至少配一组（PROVIDER + MODEL + API_KEY）。Tier 覆盖按需填。
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

LLM_CRITICAL_PROVIDER=
LLM_CRITICAL_MODEL=
LLM_CRITICAL_BASE_URL=
LLM_CRITICAL_API_KEY=

LLM_STANDARD_PROVIDER=
LLM_STANDARD_MODEL=
LLM_STANDARD_BASE_URL=
LLM_STANDARD_API_KEY=

LLM_SIMPLE_PROVIDER=
LLM_SIMPLE_MODEL=
LLM_SIMPLE_BASE_URL=
LLM_SIMPLE_API_KEY=

# 详细可选项（market data / news 源 / OAuth / Prometheus / 部署 region 等）
# 直接对照 .env.example 复制需要的段过来。生产无关项保持留空即可。
