{
  "name": "@fundai/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Shared HTTP API client + TypeScript types for FundAI web and Android RN apps. Single source of truth for endpoint signatures.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
