#!/usr/bin/env bash
# .githooks/pre-commit — repo-tracked git hook installed via
# `scripts/install-git-hooks.sh` (sets core.hooksPath=.githooks).
#
# WHY THIS HOOK
# -------------
# W7-3 — catch i18n key drift at commit time so the developer
# doesn't have to wait for CI to discover that an English key
# was added without its Chinese twin (or that an interpolation
# placeholder vanished from one locale). The CI step
# (frontend.test:i18n-keys in .github/workflows/ci.yml) is the
# source of truth; this hook is only an early-warning.
#
# We deliberately keep the hook narrow:
#   * Only runs if the staged change touches the i18n locale dir
#     OR the parity test itself. Any other commit sees the hook
#     return immediately, so the dev experience stays fast.
#   * Bypassable with `git commit --no-verify` for the rare case
#     of an intentional partial migration in flight (the CI step
#     will still block the PR from merging — this is just a
#     local guardrail, not an enforcement boundary).
#   * Falls back gracefully if Node / npm aren't on PATH (some
#     contributors only edit Go); it prints a warning instead of
#     blocking.

set -euo pipefail

# Detect whether any staged file is in scope. We check both the
# locale dir and the parity test itself so a developer changing
# the test (e.g. tightening the assertion surface) also exercises
# it on save.
in_scope=0
while IFS= read -r path; do
  case "$path" in
    web/src/i18n/locales/*|web/test/i18nNamespaceParity.test.ts)
      in_scope=1
      break
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "$in_scope" -eq 0 ]; then
  exit 0
fi

# Soft-fail when the toolchain isn't installed: a backend-only
# contributor without Node shouldn't be blocked here. The CI
# workflow will catch any drift before merge.
if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  printf '\033[1;33m[pre-commit]\033[0m i18n parity guard skipped — node/npm not on PATH.\n'
  exit 0
fi

cyan='\033[0;36m'
red='\033[0;31m'
green='\033[0;32m'
nc='\033[0m'

printf "${cyan}==>${nc} pre-commit: running i18n key parity guard\n"

if (cd web && npm run --silent test:i18n-keys); then
  printf "${green}[pre-commit]${nc} i18n parity guard passed.\n"
  exit 0
fi

printf "${red}[pre-commit]${nc} i18n parity guard FAILED.\n"
printf "Fix the missing / extra keys above, or bypass with --no-verify\n"
printf "(CI will still enforce parity on the PR).\n"
exit 1
