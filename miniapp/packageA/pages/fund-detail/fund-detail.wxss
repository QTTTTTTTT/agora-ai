.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 40rpx;
}

/* 头部渐变 */
.header {
  padding: 60rpx 40rpx 50rpx;
  color: #fff;
  border-radius: 0 0 30rpx 30rpx;
}
.header-up {
  background: linear-gradient(135deg, #e53935, #ff7043);
}
.header-down {
  background: linear-gradient(135deg, #43a047, #66bb6a);
}
.header-content {
  display: flex;
  flex-direction: column;
}
.fund-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.nav-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.nav-value {
  font-size: 64rpx;
  font-weight: 700;
}
.daily-change {
  font-size: 30rpx;
  font-weight: 500;
}
.change-percent {
  margin-left: 8rpx;
}
.nav-date {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 12rpx;
}

/* 卡片 */
.card {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 基本信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.info-label {
  font-size: 24rpx;
  color: #999;
}
.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 模式badge */
.mode-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx !important;
}
.mode-simulation {
  background: #e3f2fd;
  color: #1565c0;
}
.mode-paper {
  background: #fff3e0;
  color: #e65100;
}
.mode-live {
  background: #fce4ec;
  color: #c62828;
}

/* 指标网格 */
.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 24rpx;
}
.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
  background: #fafafa;
  border-radius: 12rpx;
}
.metric-label {
  font-size: 22rpx;
  color: #999;
}
.metric-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.text-up {
  color: #e53935;
}
.text-down {
  color: #43a047;
}

/* Agent列表 */
.agents-list {
  display: flex;
  flex-direction: column;
}
.agent-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.agent-row:last-child {
  border-bottom: none;
}
.agent-emoji {
  font-size: 44rpx;
  margin-right: 20rpx;
}
.agent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.agent-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}
.agent-role {
  font-size: 24rpx;
  color: #999;
}
.agent-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 操作按钮 */
.actions-card {
  margin: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.btn-secondary {
  background: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
}

/* 模式选择弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}
.modal-content {
  background: #fff;
  width: 100%;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 30rpx;
  color: #1a1a2e;
}
.mode-option {
  display: flex;
  flex-direction: column;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid #eee;
  position: relative;
}
.mode-active {
  border-color: #667eea;
  background: #f5f3ff;
}
.mode-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  text-transform: capitalize;
}
.mode-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.mode-check {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #667eea;
  font-size: 36rpx;
  font-weight: 700;
}
.btn-cancel {
  margin-top: 16rpx;
  background: #f5f5f5;
  color: #666;
  border: none;
  border-radius: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

/* 自动决策卡片 */
.auto-exec-card {
  padding-bottom: 24rpx;
}
.auto-exec-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.auto-exec-title-block {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.card-title-inline {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}
.auto-exec-state {
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.state-on {
  color: #28a745;
}
.state-off {
  color: #999;
}
.auto-exec-meta {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
  background: #f9f9fb;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
}
.auto-exec-actions {
  margin-top: 16rpx;
}
.btn-link {
  background: transparent;
  color: #5664f5;
  border: none;
  font-size: 26rpx;
  padding: 0;
  text-align: left;
}
.btn-link::after { border: none; }

/* 自动决策设置弹窗 */
.auto-exec-sheet {
  max-height: 88vh;
  overflow-y: auto;
}
.auto-exec-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
}
.auto-exec-row-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.auto-exec-scope {
  background: #fff8e1;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  margin: 12rpx 0 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.auto-exec-scope-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #b07a00;
  margin-bottom: 6rpx;
}
.auto-exec-scope-item {
  font-size: 22rpx;
  color: #8a5d00;
  line-height: 1.5;
}
.auto-exec-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 22rpx;
}
.auto-exec-field-label {
  font-size: 24rpx;
  color: #666;
}
.auto-exec-input {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  font-size: 28rpx;
  background: #fff;
  color: #333;
}
.auto-exec-picker {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  font-size: 28rpx;
  background: #fff;
  color: #333;
}
.auto-exec-field-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #888;
  line-height: 1.5;
}
.auto-exec-field-tier {
  background: #f6f5ff;
  border: 2rpx solid #e7e3ff;
  border-radius: 16rpx;
  padding: 18rpx;
}
.auto-exec-field-tier .auto-exec-field-label {
  color: #4338ca;
  font-weight: 600;
}
.auto-exec-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.auto-exec-buttons .btn-cancel,
.auto-exec-buttons .btn-primary {
  flex: 1;
  margin-top: 0;
}
