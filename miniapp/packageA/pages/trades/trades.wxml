<view class="page">
  <!-- 顶部筛选栏 -->
  <view class="filter-bar">
    <view class="date-filters">
      <picker mode="date" value="{{dateStart}}" bindchange="onDateStartChange">
        <view class="date-picker">{{dateStart}}</view>
      </picker>
      <text class="date-sep">至</text>
      <picker mode="date" value="{{dateEnd}}" bindchange="onDateEndChange">
        <view class="date-picker">{{dateEnd}}</view>
      </picker>
    </view>
    <view class="filter-tabs">
      <view class="tab {{filterTab === 'all' ? 'tab-active' : ''}}" bindtap="onFilterTab" data-tab="all">全部</view>
      <view class="tab {{filterTab === 'buy' ? 'tab-active' : ''}}" bindtap="onFilterTab" data-tab="buy">买入</view>
      <view class="tab {{filterTab === 'sell' ? 'tab-active' : ''}}" bindtap="onFilterTab" data-tab="sell">卖出</view>
    </view>
    <view class="search-box">
      <input class="search-input" placeholder="搜索股票代码/名称" value="{{searchKey}}" bindinput="onSearchInput" />
    </view>
  </view>

  <!-- P0-5 操作反馈 -->
  <view wx:if="{{actionMessage}}" class="action-banner banner-{{actionMessage.tone}}" bindtap="onDismissActionMessage">
    <text>{{actionMessage.text}}</text>
    <text class="banner-close">×</text>
  </view>

  <!-- 交易统计 -->
  <view class="stats-bar">
    <view class="stat-item">
      <text class="stat-num">{{stats.total}}</text>
      <text class="stat-label">总交易数</text>
    </view>
    <view class="stat-item">
      <text class="stat-num stat-buy">{{stats.buyCount}}</text>
      <text class="stat-label">买入</text>
    </view>
    <view class="stat-item">
      <text class="stat-num stat-sell">{{stats.sellCount}}</text>
      <text class="stat-label">卖出</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">¥{{stats.totalFee}}</text>
      <text class="stat-label">总手续费</text>
    </view>
  </view>

  <!-- 交易列表 -->
  <scroll-view class="trade-list" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="trade-item" wx:for="{{filteredTrades}}" wx:key="id">
      <view class="trade-main" bindtap="onToggleExpand" data-id="{{item.id}}">
        <view class="trade-left">
          <view class="trade-datetime">
            <text class="trade-date">{{item.date}}</text>
            <text class="trade-time">{{item.time}}</text>
          </view>
          <view class="trade-badge badge-{{item.type}}">{{item.typeText}}</view>
        </view>
        <view class="trade-center">
          <view class="stock-info">
            <text class="stock-code">{{item.stockCode}}</text>
            <text class="stock-name">{{item.stockName}}</text>
          </view>
          <view class="trade-nums">
            <text class="trade-qty">{{item.quantity}}股</text>
            <text class="trade-price">@{{item.price}}</text>
          </view>
        </view>
        <view class="trade-right">
          <text class="trade-amount">¥{{item.amount}}</text>
          <text class="trade-fee">手续费: ¥{{item.fee}}</text>
          <text class="trade-status">{{item.status}}</text>
        </view>
      </view>

      <!-- 展开详情 -->
      <view class="trade-detail" wx:if="{{expandedId === item.id}}">
        <view class="detail-row">
          <text class="detail-label">执行策略</text>
          <text class="detail-value">{{item.strategy}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">滑点</text>
          <text class="detail-value">{{item.slippage}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">子订单数</text>
          <text class="detail-value">{{item.subOrders}}</text>
        </view>
        <!-- P0-5 — 仅在订单仍可改/撤时渲染按钮。已成交/已取消等终态隐藏。 -->
        <view class="detail-actions" wx:if="{{item.canModify}}">
          <button class="action-btn action-replace" size="mini" loading="{{busyOrderId === item.id}}" disabled="{{busyOrderId && busyOrderId !== item.id}}" bindtap="onOpenReplace" data-id="{{item.id}}">改单</button>
          <button class="action-btn action-cancel" size="mini" loading="{{busyOrderId === item.id}}" disabled="{{busyOrderId && busyOrderId !== item.id}}" bindtap="onCancelOrder" data-id="{{item.id}}">取消订单</button>
        </view>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{filteredTrades.length === 0}}">
      <text>暂无匹配的交易记录</text>
    </view>
  </scroll-view>

  <!-- 底部统计 -->
  <view class="bottom-stats">
    <view class="bottom-stat">
      <text class="bottom-label">总成交金额</text>
      <text class="bottom-value">¥{{totalAmount}}</text>
    </view>
    <view class="bottom-stat">
      <text class="bottom-label">总手续费</text>
      <text class="bottom-value">¥{{totalFees}}</text>
    </view>
  </view>

  <!-- P0-5 改单弹窗 — 仅修改的字段会发送给服务端，空字段不传，服务端
       负责拒绝全空 payload / quantity < filledQty 等非法情况。 -->
  <view wx:if="{{replaceVisible}}" class="modal-mask" catchtap="onCloseReplace">
    <view class="modal-card" catchtap="">
      <view class="modal-header">
        <text class="modal-title">修改订单 {{replaceForm.stockCode}}</text>
        <text class="modal-close" bindtap="onCloseReplace">×</text>
      </view>
      <view class="modal-body">
        <view class="modal-row">
          <text class="modal-label">数量</text>
          <input class="modal-input" type="digit" value="{{replaceForm.quantity}}" placeholder="保留则不修改" data-field="quantity" bindinput="onReplaceFieldInput" />
        </view>
        <view class="modal-row">
          <text class="modal-label">限价</text>
          <input class="modal-input" type="digit" value="{{replaceForm.limitPrice}}" placeholder="保留则不修改" data-field="limitPrice" bindinput="onReplaceFieldInput" />
        </view>
        <view class="modal-row">
          <text class="modal-label">止损价</text>
          <input class="modal-input" type="digit" value="{{replaceForm.stopPrice}}" placeholder="可空" data-field="stopPrice" bindinput="onReplaceFieldInput" />
        </view>
        <view class="modal-row">
          <text class="modal-label">移动止损 ¥</text>
          <input class="modal-input" type="digit" value="{{replaceForm.trailAmount}}" placeholder="可空" data-field="trailAmount" bindinput="onReplaceFieldInput" />
        </view>
        <view class="modal-row">
          <text class="modal-label">移动止损 %</text>
          <input class="modal-input" type="digit" value="{{replaceForm.trailPercent}}" placeholder="可空" data-field="trailPercent" bindinput="onReplaceFieldInput" />
        </view>
        <view class="modal-row">
          <text class="modal-label">显露数量</text>
          <input class="modal-input" type="digit" value="{{replaceForm.displayQty}}" placeholder="iceberg 才有" data-field="displayQty" bindinput="onReplaceFieldInput" />
        </view>
        <view class="modal-row">
          <text class="modal-label">备注</text>
          <input class="modal-input" value="{{replaceForm.note}}" placeholder="可空" data-field="note" bindinput="onReplaceFieldInput" />
        </view>
      </view>
      <view class="modal-actions">
        <button class="modal-btn modal-cancel" size="mini" bindtap="onCloseReplace">取消</button>
        <button class="modal-btn modal-confirm" size="mini" type="primary" loading="{{busyOrderId === replaceForm.id}}" bindtap="onSubmitReplace">提交修改</button>
      </view>
    </view>
  </view>
</view>
