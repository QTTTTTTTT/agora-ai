.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 60rpx;
}

.empty-state {
  margin: 160rpx 32rpx 0;
  padding: 48rpx 32rpx;
  border-radius: 20rpx;
  background: #fff;
  color: #999;
  font-size: 28rpx;
  text-align: center;
}

.empty-section {
  padding: 20rpx 0;
  color: #999;
  font-size: 26rpx;
  text-align: center;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 50rpx 30rpx 40rpx;
  color: #fff;
  border-radius: 0 0 30rpx 30rpx;
}
.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.plan-title {
  font-size: 36rpx;
  font-weight: 600;
  flex: 1;
}
.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}
.status-pending {
  background: rgba(255,193,7,0.2);
  color: #ffd54f;
  border: 1rpx solid rgba(255,193,7,0.4);
}
.status-approved {
  background: rgba(76,175,80,0.2);
  color: #81c784;
  border: 1rpx solid rgba(76,175,80,0.4);
}
.status-rejected {
  background: rgba(244,67,54,0.2);
  color: #ef9a9a;
  border: 1rpx solid rgba(244,67,54,0.4);
}
.header-meta {
  margin-top: 20rpx;
}
.plan-date {
  font-size: 26rpx;
  opacity: 0.8;
}
.confidence-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
.confidence-label {
  font-size: 24rpx;
  opacity: 0.8;
}
.confidence-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 6rpx;
  overflow: hidden;
}
.confidence-fill {
  height: 100%;
  background: #ffd54f;
  border-radius: 6rpx;
  transition: width 0.3s;
}
.confidence-num {
  font-size: 28rpx;
  font-weight: 600;
}

/* 卡片 */
.card {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.expand-icon {
  font-size: 24rpx;
  color: #667eea;
}

/* 推理文本 */
.reasoning-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  white-space: pre-wrap;
}
.collapsed {
  max-height: 120rpx;
  overflow: hidden;
  position: relative;
}
.collapsed::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(transparent, #fff);
}
.expanded {
  max-height: none;
}

/* 操作表格 */
.action-table {
  overflow-x: auto;
}
.table-header {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}
.table-header text {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
}
.col-type { width: 100rpx; }
.col-stock { width: 120rpx; }
.col-pos { width: 150rpx; }
.col-qty { width: 120rpx; }
.col-price { flex: 1; text-align: right; }

.table-row {
  border-bottom: 1rpx solid #f5f5f5;
  padding: 16rpx 0;
}
.row-main {
  display: flex;
  align-items: center;
}
.row-main text {
  font-size: 26rpx;
  color: #333;
}
.action-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  text-align: center;
}
.action-buy {
  background: #fce4ec;
  color: #e53935;
}
.action-sell {
  background: #e8f5e9;
  color: #43a047;
}
.action-rebalance {
  background: #e3f2fd;
  color: #1565c0;
}
.row-reason {
  margin-top: 10rpx;
  padding-left: 100rpx;
}
.reason-label {
  font-size: 22rpx;
  color: #999;
}
.reason-text {
  font-size: 22rpx;
  color: #666;
  line-height: 1.6;
}

/* 风控审查 */
.overall-badge {
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.overall-pass {
  background: #e8f5e9;
  color: #2e7d32;
}
.overall-warning {
  background: #fff3e0;
  color: #e65100;
}
.overall-fail {
  background: #fce4ec;
  color: #c62828;
}
.checks-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.check-item {
  padding: 16rpx;
  background: #fafbfe;
  border-radius: 12rpx;
}
.check-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.check-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}
.check-pass {
  background: #e8f5e9;
  color: #2e7d32;
}
.check-warning {
  background: #fff3e0;
  color: #e65100;
}
.check-fail {
  background: #fce4ec;
  color: #c62828;
}
.check-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
.check-detail {
  font-size: 24rpx;
  color: #999;
  padding-left: 70rpx;
}

/* 审批 */
.comment-input {
  width: 100%;
  min-height: 120rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}
.approval-btns {
  display: flex;
  gap: 20rpx;
}
.btn-approve {
  flex: 1;
  background: #43a047;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}
.btn-reject {
  flex: 1;
  background: #fff;
  color: #e53935;
  border: 2rpx solid #e53935;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}
.btn-refresh {
  flex: 1;
  background: #fff7e6;
  color: #b76e00;
  border: 2rpx solid #f0a020;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}
.btn-refresh[disabled] {
  opacity: 0.6;
}

/* Price-refresh confirmation modal */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
}
.modal-card {
  width: 100%;
  max-width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.2);
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 12rpx;
}
.modal-subtitle {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
  display: block;
}
.diff-table {
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}
.diff-header,
.diff-row {
  display: flex;
  padding: 16rpx 18rpx;
  font-size: 26rpx;
}
.diff-header {
  background: #fafafa;
  color: #888;
  font-size: 24rpx;
}
.diff-row + .diff-row {
  border-top: 1rpx solid #f3f3f3;
}
.diff-col {
  flex: 1;
}
.diff-sym {
  flex: 1.2;
  font-weight: 500;
  color: #222;
}
.diff-old,
.diff-new {
  text-align: right;
  color: #333;
}
.diff-drift {
  text-align: right;
  font-weight: 600;
}
.drift-up {
  color: #1d8348;
}
.drift-down {
  color: #c0392b;
}
.drift-flat {
  color: #555;
}
.btn-ack {
  width: 100%;
  background: #4f46e5;
  color: #fff;
  border: none;
  border-radius: 14rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}

/* 审批结果 */
.result-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.result-badge {
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.result-comment {
  font-size: 26rpx;
  color: #666;
}

/* 关联圆桌 */
.rt-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.rt-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.rt-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.rt-meta {
  font-size: 24rpx;
  color: #999;
}
.btn-goto {
  background: #667eea;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 26rpx;
  min-width: auto;
}
