/* ============================================
   AI基金平台 - 全局样式
   ----------------------------------------------
   2026 cream / sage / ink design refresh: shifts
   the entire color system to the cream-paper +
   sage-green + black-pill aesthetic shared with
   web (`web/src/theme/*`) and Android. Existing
   `.card` / `.badge-*` / `.btn-*` utilities keep
   their semantics so legacy pages (which read
   them via class names) automatically inherit
   the new look without per-page churn.
   ============================================ */

/* ---------- CSS 变量 ---------- */
page {
  /* primary -> sage green; secondary accent -> coral; the
     historical "indigo primary" lives only as `--color-brand-legacy`
     in case a chart absolutely needs it. */
  --color-primary: #1faa64;
  --color-primary-light: #9ec99a;
  --color-primary-dark: #0f6a3f;
  --color-success: #1faa64;
  --color-success-light: #73b272;
  --color-warning: #f7a05d;        /* coral-300 */
  --color-warning-light: #f08a40;
  --color-danger: #e64949;
  --color-danger-light: #ee7079;
  --color-info: #4f46e5;
  --color-brand-legacy: #4f46e5;

  /* ink scale — used by primary CTA fills and headings */
  --color-ink: #111110;
  --color-ink-700: #1f1d18;
  --color-ink-300: #7a766c;

  /* cream / sage / coral / risk surface tints */
  --color-cream: #f4f2ee;
  --color-cream-100: #ebe8e1;
  --color-sage: #dcebd6;
  --color-sage-700: #0f6a3f;
  --color-coral: #fbe1d1;
  --color-coral-500: #dc6f24;
  --color-risk: #fad1d3;
  --color-risk-500: #c5343a;

  --color-text-primary: var(--color-ink-700);
  --color-text-secondary: var(--color-ink-300);
  --color-text-placeholder: #b3afa2;
  --color-text-white: #ffffff;

  --color-bg-page: var(--color-cream);
  --color-bg-card: #ffffff;
  --color-bg-hover: #faf8f3;
  --color-border: #e5e3dd;

  --radius-sm: 8rpx;
  --radius-md: 24rpx;          /* envelope card radius */
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  --radius-full: 999rpx;

  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-md: 32rpx;
  --font-lg: 36rpx;
  --font-xl: 40rpx;
  --font-xxl: 48rpx;

  --shadow-sm: 0 2rpx 12rpx rgba(28, 28, 24, 0.04);
  --shadow-md: 0 6rpx 28rpx rgba(28, 28, 24, 0.08);
  --shadow-lg: 0 12rpx 40rpx rgba(28, 28, 24, 0.12);
  --shadow-ink: 0 6rpx 18rpx rgba(17, 17, 16, 0.32);
}

/* ---------- 全局 page 样式 ---------- */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Microsoft YaHei', 'Source Han Sans SC', sans-serif;
  font-size: var(--font-base);
  color: var(--color-text-primary);
  /* Soft cream paper with sage / coral wash, mirrors web body bg
     but driven via `background-image` so it survives layered
     scroll-views (a hard #color page can clip the wash). */
  background-color: var(--color-bg-page);
  background-image:
    radial-gradient(circle at 0% 0%, rgba(158, 201, 154, 0.20) 0%, transparent 38%),
    radial-gradient(circle at 100% 0%, rgba(247, 196, 163, 0.13) 0%, transparent 32%),
    radial-gradient(circle at 50% 110%, rgba(158, 201, 154, 0.10) 0%, transparent 42%);
  line-height: 1.6;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 盒模型统一 ---------- */
view, text, image, navigator, scroll-view, swiper, button, input, textarea, form {
  box-sizing: border-box;
}

/* ---------- 卡片 ---------- */
.card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-lg);
  margin: var(--spacing-md) var(--spacing-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(229, 227, 221, 0.6);
}

.card-no-padding {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  margin: var(--spacing-md) var(--spacing-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(229, 227, 221, 0.6);
  overflow: hidden;
}

/* Envelope card — the signature white "lifted paper" surface in
   the refresh. 24rpx radius, soft drop shadow, 1rpx hairline. */
.envelope-card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 36rpx 36rpx;
  margin: 24rpx 32rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(229, 227, 221, 0.7);
}

.envelope-card-compact {
  padding: 24rpx 28rpx;
}

/* Section eyebrow — small caps gray label that sits above
   an envelope card (e.g. "团队驾驶舱" / "数据整备" / "阵容"). */
.section-eyebrow {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: var(--color-ink-300);
  font-weight: 600;
  padding: 0 36rpx;
  margin-top: 24rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-eyebrow .trailing {
  color: var(--color-sage-700);
  font-weight: 700;
  font-size: 26rpx;
  letter-spacing: 0;
  text-transform: none;
}

/* ---------- 徽章 ---------- */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  line-height: 1.4;
  white-space: nowrap;
  font-weight: 500;
}

.badge-primary {
  background-color: var(--color-sage);
  color: var(--color-sage-700);
}

.badge-success {
  background-color: var(--color-sage);
  color: var(--color-sage-700);
}

.badge-warning {
  background-color: var(--color-coral);
  color: var(--color-coral-500);
}

.badge-danger {
  background-color: var(--color-risk);
  color: var(--color-risk-500);
}

.badge-info {
  background-color: rgba(79, 70, 229, 0.12);
  color: var(--color-brand-legacy);
}

/* Pill tags — same surface as `.badge` but with a more
   editorial scale and dot variant. Pages can use
   `pill-tag pill-tag-sage` (etc) interchangeably with the
   legacy `badge-success` class. */
.pill-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 22rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
}

.pill-tag-sage  { background-color: var(--color-sage);  color: var(--color-sage-700); }
.pill-tag-coral { background-color: var(--color-coral); color: var(--color-coral-500); }
.pill-tag-risk  { background-color: var(--color-risk);  color: var(--color-risk-500); }
.pill-tag-ink   { background-color: var(--color-cream-100); color: var(--color-ink-700); }
.pill-tag-muted { background-color: var(--color-cream-100); color: var(--color-ink-300); }
.pill-tag-info  { background-color: rgba(79, 70, 229, 0.12); color: var(--color-brand-legacy); }

.pill-tag-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: currentColor;
  opacity: 0.7;
}

/* ---------- 标题 ---------- */
.section-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  padding: var(--spacing-md) var(--spacing-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title .more {
  font-size: var(--font-sm);
  font-weight: 400;
  color: var(--color-text-secondary);
}

.page-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  padding: var(--spacing-lg);
}

/* ---------- Flex 布局 ---------- */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.flex-shrink-0 {
  flex-shrink: 0;
}

/* ---------- 间距 ---------- */
.gap-xs {
  gap: var(--spacing-xs);
}

.gap-sm {
  gap: var(--spacing-sm);
}

.gap-md {
  gap: var(--spacing-md);
}

.gap-lg {
  gap: var(--spacing-lg);
}

/* ---------- 文字颜色 ---------- */
.text-green {
  color: var(--color-success);
}

.text-red {
  color: var(--color-danger);
}

.text-primary {
  color: var(--color-primary);
}

.text-warning {
  color: var(--color-warning);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-white {
  color: var(--color-text-white);
}

/* ---------- 文字大小 ---------- */
.text-xs {
  font-size: var(--font-xs);
}

.text-sm {
  font-size: var(--font-sm);
}

.text-base {
  font-size: var(--font-base);
}

.text-md {
  font-size: var(--font-md);
}

.text-lg {
  font-size: var(--font-lg);
}

.text-xl {
  font-size: var(--font-xl);
}

/* ---------- 文字样式 ---------- */
.text-bold {
  font-weight: 600;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 按钮 ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 18rpx 36rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-base);
  font-weight: 600;
  line-height: 1.5;
  border: none;
  outline: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background-color: var(--color-primary);
  color: var(--color-text-white);
}

.btn-primary-outline {
  background-color: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn-success {
  background-color: var(--color-success);
  color: var(--color-text-white);
}

/* Black pill CTA — matches "装备 →" / "去回测验证" buttons in
   the design refresh. Use this for the dominant action on the
   page (only one per screen). */
.btn-ink {
  background-color: var(--color-ink);
  color: var(--color-text-white);
  box-shadow: var(--shadow-ink);
}

.btn-ghost {
  background-color: var(--color-bg-card);
  color: var(--color-ink-700);
  border: 1rpx solid var(--color-border);
}

.btn-block {
  display: flex;
  width: 100%;
}

.btn-sm {
  padding: 10rpx 24rpx;
  font-size: var(--font-sm);
}

.btn-lg {
  padding: 26rpx 56rpx;
  font-size: var(--font-md);
}

/* Bottom sticky action bar — anchors a black-pill CTA to the
   foot of any scroll surface (mirrors the bottom bar in
   WechatIMG180). */
.sticky-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx 24rpx;
  z-index: 50;
  pointer-events: none;
}

.sticky-action-bar > .inner {
  pointer-events: auto;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background-color: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
  padding: 12rpx 16rpx;
  box-shadow: var(--shadow-md);
  backdrop-filter: blur(12px);
}

/* Mascot avatar — pixel-art role portrait. The wxml provides
   the role + image source; this just sizes the circle bg.
   Mini-program can't easily inline 16x16 SVG grids the way
   web does, so we ship a simpler "tinted circle + emoji" look
   that still reads as a chunky retro avatar at thumbnail size. */
.mascot {
  width: 144rpx;
  height: 144rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  line-height: 1;
}

.mascot-sm { width: 96rpx; height: 96rpx; border-radius: 28rpx; font-size: 56rpx; }

.mascot-captain { background-color: #f0ebe0; }
.mascot-intel   { background-color: #e6f0e8; }
.mascot-picker  { background-color: #f1ece2; }
.mascot-trader  { background-color: #e9f1e2; }
.mascot-risk    { background-color: #f4e6e0; }
.mascot-analyst { background-color: #eef2ff; }

/* ---------- 分割线 ---------- */
.divider {
  height: 1rpx;
  background-color: var(--color-border);
  margin: var(--spacing-md) 0;
}

/* ---------- 头像 ---------- */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background-color: var(--color-bg-hover);
}

.avatar-sm {
  width: 56rpx;
  height: 56rpx;
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
}

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) var(--spacing-lg);
  color: var(--color-text-placeholder);
  font-size: var(--font-sm);
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-md);
}

/* ---------- 安全区域适配 ---------- */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.safe-area-inset-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}

/* ---------- 底部 TabBar 占位 ---------- */
.tabbar-placeholder {
  height: 120rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---------- Loading 占位 ---------- */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: var(--radius-sm);
}

@keyframes skeleton-loading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}
