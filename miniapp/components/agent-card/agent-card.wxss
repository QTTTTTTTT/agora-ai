/* Agent card — cream / sage / ink refresh.
   The card mirrors the "lifted paper" look used by web's
   EnvelopeCard and Android's ThemedCard: 24rpx radius, soft
   drop shadow, hairline border, and a colored mascot circle
   that picks its background from the agent's role.
   ----------------------------------------------------------
   The role / status emoji + colors come from utils/util.js
   so we only change presentation, not behaviour. */

.agent-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(28, 28, 24, 0.06);
  border: 1rpx solid rgba(229, 227, 221, 0.6);
  gap: 24rpx;
  transition: background-color 0.2s, box-shadow 0.2s;
}

.agent-card-hover {
  background-color: #faf7f1;
  box-shadow: 0 6rpx 26rpx rgba(28, 28, 24, 0.10);
}

/* 头像 */
.agent-avatar {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  background: #f0ebe0;
  border-radius: 26rpx;       /* squarer pixel-art frame */
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.status-dot {
  position: absolute;
  bottom: -2rpx;
  right: -2rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 1rpx 3rpx rgba(28, 28, 24, 0.18);
}

/* 信息区域 */
.agent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.agent-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.agent-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1d18;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.role-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #0f6a3f;             /* sage-700 text */
  background: #dcebd6;        /* sage-100 fill */
  border: none;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.agent-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #7a766c;
}

.agent-divider {
  color: #c5c1b6;
}

.agent-model {
  font-family: monospace;
  font-size: 22rpx;
  color: #7a766c;
}

.agent-style {
  font-size: 22rpx;
  color: #7a766c;
}

.agent-status-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-indicator {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.status-text {
  font-size: 22rpx;
  color: #7a766c;
}

/* 箭头 */
.agent-arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 36rpx;
  color: #c5c1b6;
  font-weight: 300;
}
