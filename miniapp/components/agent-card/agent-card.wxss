.agent-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  gap: 20rpx;
  transition: background-color 0.2s;
}

.agent-card-hover {
  background-color: #f5f5f5;
}

/* 头像 */
.agent-avatar {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  background: #f0f5ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-emoji {
  font-size: 40rpx;
}

.status-dot {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
}

/* 信息区域 */
.agent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.agent-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.agent-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #262626;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.role-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #1890ff;
  background: #e6f7ff;
  border: 1rpx solid #91d5ff;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.agent-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #8c8c8c;
}

.agent-divider {
  color: #d9d9d9;
}

.agent-model {
  font-family: monospace;
  font-size: 22rpx;
  color: #8c8c8c;
}

.agent-style {
  font-size: 22rpx;
  color: #8c8c8c;
}

.agent-status-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-indicator {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.status-text {
  font-size: 22rpx;
  color: #8c8c8c;
}

/* 箭头 */
.agent-arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 36rpx;
  color: #d9d9d9;
  font-weight: 300;
}
