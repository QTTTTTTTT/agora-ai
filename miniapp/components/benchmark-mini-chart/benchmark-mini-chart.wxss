.bm-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 28rpx;
  margin: 0 16rpx 16rpx;
  border: 1rpx solid #eef0f5;
}

.bm-header {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.bm-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bm-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  letter-spacing: 1rpx;
}

.bm-subtitle {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.bm-range-row {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
}

.bm-range-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e7eb;
  background: #f9fafb;
  font-size: 22rpx;
  color: #6b7280;
}

.bm-range-pill--active {
  border-color: #4f46e5;
  background: #eef2ff;
  color: #4f46e5;
  font-weight: 600;
}

.bm-state {
  padding: 64rpx 0;
  text-align: center;
  color: #6b7280;
  font-size: 24rpx;
}

.bm-state--error {
  color: #b91c1c;
}

.bm-retry {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  background: #dc2626;
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.bm-body {
  display: flex;
  flex-direction: column;
}

.bm-overlap {
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid;
}

.bm-overlap--dominant {
  border-color: #c7d2fe;
  background: #eef2ff;
}

.bm-overlap--partial {
  border-color: #fde68a;
  background: #fffbeb;
}

.bm-overlap-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #312e81;
  display: block;
}

.bm-overlap--partial .bm-overlap-title {
  color: #92400e;
}

.bm-overlap-body {
  font-size: 22rpx;
  color: #312e81;
  display: block;
  margin-top: 4rpx;
  line-height: 1.5;
}

.bm-overlap--partial .bm-overlap-body {
  color: #78350f;
}

.bm-legend {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.bm-legend-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.bm-legend-swatch {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

.bm-legend-swatch--fund {
  background: #4f46e5;
}

.bm-legend-swatch--bench {
  background: #0ea5e9;
}

.bm-legend-label {
  font-size: 22rpx;
  color: #374151;
}

.bm-canvas-wrap {
  width: 100%;
  position: relative;
}

.bm-canvas {
  display: block;
}

.bm-partial-failure {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #b45309;
}
