/* metric-card — cream / sage / ink refresh.
   Larger radius, softer shadow, ink-700 value, sage-500 vs
   risk-500 for trend arrows so all metric tiles match the
   envelope-card aesthetic on the index page. */

.metric-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(28, 28, 24, 0.06);
  border: 1rpx solid rgba(229, 227, 221, 0.7);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.metric-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.metric-icon {
  font-size: 28rpx;
}

.metric-label {
  font-size: 22rpx;
  color: #7a766c;
  line-height: 1.4;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1.5rpx;
}

.metric-body {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.metric-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #1f1d18;
  line-height: 1.1;
  letter-spacing: 0.5rpx;
}

.metric-trend {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.trend-arrow {
  font-size: 24rpx;
  font-weight: 700;
}

.sub-value {
  font-size: 24rpx;
  font-weight: 600;
}

/* 趋势颜色类 — A 股审美：上涨红 / 下跌绿 */
.trend-up .trend-arrow,
.trend-up .sub-value {
  color: #c5343a;
}

.trend-down .trend-arrow,
.trend-down .sub-value {
  color: #1faa64;
}

.trend-flat .trend-arrow,
.trend-flat .sub-value {
  color: #b3afa2;
}
