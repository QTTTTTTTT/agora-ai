/* packageB/pages/model-config/model-config.wxss */
.page-container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* === section === */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 20rpx;
}

/* === tier header === */
.tier-header {
  margin-bottom: 20rpx;
}

.tier-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tier-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.tier-dot-critical { background: #ef4444; }
.tier-dot-standard { background: #f59e0b; }
.tier-dot-simple { background: #10b981; }

.tier-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.tier-desc {
  font-size: 24rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 4rpx;
  line-height: 1.5;
}

.tier-steps {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
}

/* === model list === */
.model-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.model-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #e5e7eb;
  transition: all 0.2s;
}

.model-item-selected {
  border-color: #6366f1;
  background: #f5f3ff;
}

.model-radio {
  margin-right: 20rpx;
}

.radio-outer {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
}

.model-item-selected .radio-outer {
  border-color: #6366f1;
}

.radio-inner {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #6366f1;
}

.model-info {
  flex: 1;
}

.model-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.model-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.model-recommend-badge {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.model-meta {
  display: flex;
  gap: 20rpx;
}

.model-provider {
  font-size: 24rpx;
  color: #6b7280;
}

.model-price {
  font-size: 24rpx;
  color: #9ca3af;
}

/* === custom key toggle === */
.tier-custom-key {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.toggle-switch {
  width: 80rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #d1d5db;
  position: relative;
  transition: background 0.2s;
}

.toggle-on {
  background: #6366f1;
}

.toggle-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff;
  transition: left 0.2s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.toggle-on .toggle-knob {
  left: 40rpx;
}

/* === custom endpoint list === */
.custom-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.custom-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #e5e7eb;
}

.custom-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.custom-card-info {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.custom-card-provider {
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.custom-card-model {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.custom-card-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.custom-card-status-active {
  background: #d1fae5;
  color: #059669;
}

.custom-card-status-error {
  background: #fee2e2;
  color: #dc2626;
}

.custom-card-url {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
  word-break: break-all;
}

.custom-card-actions {
  display: flex;
  justify-content: flex-end;
}

.custom-card-delete {
  font-size: 24rpx;
  color: #ef4444;
  padding: 8rpx 20rpx;
}

.empty-hint {
  text-align: center;
  padding: 40rpx 0;
  color: #9ca3af;
  font-size: 26rpx;
}

.add-custom-btn {
  background: #fff;
  border: 2rpx dashed #d1d5db;
  border-radius: 16rpx;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #6366f1;
  font-weight: 500;
}

/* === cost card === */
.cost-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
}

.cost-circle {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.cost-circle-inner {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ede9fe, #e0e7ff);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 6rpx solid #6366f1;
}

.cost-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #4f46e5;
}

.cost-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.cost-breakdown {
  margin-bottom: 20rpx;
}

.cost-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.cost-row:last-child {
  border-bottom: none;
}

.cost-row-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.cost-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.cost-dot-critical { background: #ef4444; }
.cost-dot-standard { background: #f59e0b; }
.cost-dot-simple { background: #10b981; }

.cost-row-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.cost-compare {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-top: 2rpx solid #e5e7eb;
  margin-top: 8rpx;
}

.cost-compare-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.cost-compare-value {
  font-size: 26rpx;
  color: #9ca3af;
  text-decoration: line-through;
}

.cost-saved {
  text-align: center;
  padding: 12rpx;
  background: #d1fae5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #059669;
  font-weight: 500;
  margin-top: 12rpx;
}

.cost-over {
  background: #fee2e2;
  color: #dc2626;
}

/* === modal === */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  padding: 32rpx 32rpx 16rpx;
  text-align: center;
}

.modal-body {
  padding: 16rpx 32rpx 24rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #4b5563;
  font-weight: 500;
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1f2937;
}

.picker-arrow {
  font-size: 20rpx;
  color: #9ca3af;
}

/* === test section === */
.test-section {
  margin-top: 8rpx;
}

.test-btn {
  background: #f3f4f6;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4f46e5;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.test-result {
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
}

.test-result-testing {
  color: #6b7280;
}

.test-result-success {
  color: #059669;
  background: #d1fae5;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
}

.test-result-fail {
  color: #dc2626;
  background: #fee2e2;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
}

/* === modal footer === */
.modal-footer {
  display: flex;
  border-top: 1rpx solid #e5e7eb;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-btn-cancel {
  color: #6b7280;
  border-right: 1rpx solid #e5e7eb;
}

.modal-btn-save {
  color: #4f46e5;
  font-weight: 600;
}
