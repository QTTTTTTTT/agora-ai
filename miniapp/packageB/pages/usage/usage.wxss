/* packageB/pages/usage/usage.wxss */
.page-container {
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* === Tab 栏 === */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #e5e7eb;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
  font-weight: 500;
}

.tab-active {
  color: #4f46e5;
  font-weight: 600;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #4f46e5;
  border-radius: 3rpx;
}

/* === tab content === */
.tab-content {
  padding: 24rpx;
}

/* === summary cards === */
.summary-cards {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.summary-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}

.summary-card-highlight {
  background: linear-gradient(135deg, #4f46e5, #6366f1);
}

.summary-card-highlight .summary-value {
  color: #fff;
}

.summary-card-highlight .summary-label {
  color: rgba(255, 255, 255, 0.8);
}

.summary-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
}

/* === section === */
.section {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
}

/* === bar chart === */
.bar-chart {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.bar-row:last-child {
  margin-bottom: 0;
}

.bar-label {
  width: 180rpx;
  flex-shrink: 0;
}

.bar-name {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #1f2937;
}

.bar-calls {
  display: block;
  font-size: 20rpx;
  color: #9ca3af;
}

.bar-track {
  flex: 1;
  height: 20rpx;
  background: #f3f4f6;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 0 12rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.3s;
}

.bar-fill-0 { background: linear-gradient(90deg, #6366f1, #818cf8); }
.bar-fill-1 { background: linear-gradient(90deg, #10b981, #34d399); }
.bar-fill-2 { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
.bar-fill-3 { background: linear-gradient(90deg, #ef4444, #f87171); }
.bar-fill-4 { background: linear-gradient(90deg, #8b5cf6, #a78bfa); }

.bar-fill-step-0 { background: #6366f1; }
.bar-fill-step-1 { background: #ef4444; }
.bar-fill-step-2 { background: #f59e0b; }
.bar-fill-step-3 { background: #10b981; }
.bar-fill-step-4 { background: #3b82f6; }

.bar-percent {
  font-size: 22rpx;
  color: #6b7280;
  width: 70rpx;
  text-align: right;
  flex-shrink: 0;
}

/* === hourly chart === */
.hourly-chart-scroll {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  white-space: nowrap;
}

.hourly-chart {
  display: flex;
  align-items: flex-end;
  height: 200rpx;
  gap: 6rpx;
  min-width: 900rpx;
}

.hourly-bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 36rpx;
  justify-content: flex-end;
  height: 100%;
}

.hourly-bar {
  width: 24rpx;
  background: linear-gradient(180deg, #6366f1, #818cf8);
  border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
}

.hourly-label {
  font-size: 16rpx;
  color: #9ca3af;
  margin-top: 6rpx;
  transform: rotate(-45deg);
  white-space: nowrap;
}

/* === month picker === */
.month-picker-row {
  margin-bottom: 20rpx;
}

.month-picker-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.picker-arrow {
  font-size: 20rpx;
  color: #9ca3af;
}

/* === heatmap === */
.heatmap-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.heatmap-cell {
  width: calc((100% - 48rpx) / 7);
  aspect-ratio: 1;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.heatmap-day {
  font-size: 20rpx;
  color: #374151;
}

.heatmap-level-0 { background: #f3f4f6; }
.heatmap-level-1 { background: #dbeafe; }
.heatmap-level-2 { background: #93c5fd; }
.heatmap-level-3 { background: #6366f1; }
.heatmap-level-3 .heatmap-day { color: #fff; }
.heatmap-level-4 { background: #4338ca; }
.heatmap-level-4 .heatmap-day { color: #fff; }

.heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  margin-top: 12rpx;
}

.heatmap-legend-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.heatmap-legend-cell {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
}

/* === rank list === */
.rank-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.rank-item:last-child {
  margin-bottom: 0;
}

.rank-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rank-index-0 { background: #f59e0b; }
.rank-index-1 { background: #9ca3af; }
.rank-index-2 { background: #cd7f32; }
.rank-index-3 { background: #d1d5db; color: #6b7280; }

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1f2937;
  display: block;
  margin-bottom: 6rpx;
}

.rank-bar-track {
  height: 12rpx;
  background: #f3f4f6;
  border-radius: 6rpx;
  overflow: hidden;
}

.rank-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #818cf8);
  border-radius: 6rpx;
}

.rank-cost {
  font-size: 26rpx;
  font-weight: 600;
  color: #4f46e5;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* === trend chart === */
.trend-chart-scroll {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  white-space: nowrap;
}

.trend-chart {
  display: flex;
  align-items: flex-end;
  height: 200rpx;
  gap: 8rpx;
  min-width: 700rpx;
}

.trend-bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 28rpx;
  justify-content: flex-end;
  height: 100%;
}

.trend-bar {
  width: 20rpx;
  background: linear-gradient(180deg, #10b981, #34d399);
  border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
}

.trend-label {
  font-size: 18rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

/* === history list === */
.history-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.history-header {
  display: flex;
  background: #f9fafb;
  padding: 16rpx 12rpx;
  font-weight: 600;
}

.history-row {
  display: flex;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.history-row:last-child {
  border-bottom: none;
}

.history-col {
  font-size: 22rpx;
  color: #4b5563;
}

.history-header .history-col {
  color: #1f2937;
  font-size: 22rpx;
}

.history-col-time { width: 180rpx; flex-shrink: 0; }
.history-col-step { flex: 1; }
.history-col-model { width: 160rpx; flex-shrink: 0; }
.history-col-tokens { width: 100rpx; flex-shrink: 0; text-align: right; }
.history-col-cost { width: 90rpx; flex-shrink: 0; text-align: right; color: #4f46e5; font-weight: 500; }

.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: #6366f1;
}

/* === bill card === */
.bill-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
}

.bill-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.bill-status {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 24rpx;
}

.bill-status-paid {
  background: #d1fae5;
  color: #059669;
}

.bill-status-pending {
  background: #fef3c7;
  color: #d97706;
}

.bill-rows {
  margin-bottom: 20rpx;
}

.bill-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.bill-row:last-child {
  border-bottom: none;
}

.bill-row-label {
  font-size: 26rpx;
  color: #4b5563;
}

.bill-row-value {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 500;
}

.bill-row-discount .bill-row-value {
  color: #10b981;
}

.bill-row-total {
  border-top: 2rpx solid #e5e7eb;
  margin-top: 8rpx;
  padding-top: 20rpx;
}

.bill-total-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #4f46e5;
}

.bill-detail-toggle {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6366f1;
}

.toggle-arrow {
  font-size: 20rpx;
}

.bill-details {
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.bill-detail-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 24rpx;
}

.bill-detail-label {
  color: #6b7280;
}

.bill-detail-value {
  color: #1f2937;
  font-weight: 500;
}

.bill-detail-discount {
  color: #10b981;
}

.bill-actions {
  margin-top: 16rpx;
}

.bill-action-btn {
  text-align: center;
  padding: 20rpx 0;
  background: #f3f4f6;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #4b5563;
  font-weight: 500;
}

/* === empty === */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #9ca3af;
  font-size: 28rpx;
}
