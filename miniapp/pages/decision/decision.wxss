/* pages/decision/decision.wxss - 决策中心 */

.page-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 120rpx;
}

/* ========== 统计头部 ========== */
.stats-header {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

.stat-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  backdrop-filter: blur(10px);
}

.stat-number {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stat-pending .stat-number {
  color: #f0a030;
}

.stat-approved .stat-number {
  color: #2ecc71;
}

.stat-rejected .stat-number {
  color: #e74c3c;
}

/* ========== Tab栏 ========== */
.tab-bar {
  display: flex;
  position: relative;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #999;
  position: relative;
  z-index: 1;
  transition: color 0.3s ease;
}

.tab-item.tab-active {
  color: #1a73e8;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 33.333%;
  height: 4rpx;
  background: #1a73e8;
  border-radius: 2rpx;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ========== 方案列表 ========== */
.plan-list {
  padding: 20rpx 30rpx;
}

.plan-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 左侧状态条 */
.plan-status-bar {
  width: 8rpx;
  flex-shrink: 0;
}

.plan-bar-pending {
  background: linear-gradient(180deg, #f0a030, #f5c842);
}

.plan-bar-approved {
  background: linear-gradient(180deg, #2ecc71, #27ae60);
}

.plan-bar-mixed {
  /* Sprint 3 / L2: partial fill — amber gradient signals "部分成交"，
     与 approved 的绿色 + rejected 的红色都明显有别。 */
  background: linear-gradient(180deg, #f39c12, #e67e22);
}

.plan-bar-rejected {
  background: linear-gradient(180deg, #e74c3c, #c0392b);
}

.plan-content {
  flex: 1;
  padding: 24rpx;
}

/* 标题行 */
.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.plan-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
  margin-right: 16rpx;
}

.plan-date {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

/* 操作摘要标签 */
.plan-operations {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.op-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.op-buy {
  background: rgba(231, 76, 60, 0.1);
  color: #e74c3c;
}

.op-sell {
  background: rgba(46, 204, 113, 0.1);
  color: #27ae60;
}

.op-adjust {
  background: rgba(52, 152, 219, 0.1);
  color: #2980b9;
}

/* 摘要 */
.plan-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

/* 风控 + 置信度 */
.plan-metrics {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.risk-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.risk-approved {
  background: rgba(46, 204, 113, 0.15);
  color: #27ae60;
}

.risk-approved_with_warnings {
  background: rgba(240, 160, 48, 0.15);
  color: #e67e22;
}

.risk-rejected {
  background: rgba(231, 76, 60, 0.15);
  color: #e74c3c;
}

.confidence-wrapper {
  flex: 1;
}

.confidence-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
  display: block;
}

.confidence-bar {
  height: 12rpx;
  background: #eef0f5;
  border-radius: 6rpx;
  overflow: hidden;
}

.confidence-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #1a73e8, #34d399);
  transition: width 0.6s ease;
}

/* 按钮行 */
.plan-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.btn {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  text-align: center;
  font-weight: 500;
}

.btn-detail {
  background: #f0f2f5;
  color: #555;
}

.btn-roundtable {
  background: rgba(26, 115, 232, 0.1);
  color: #1a73e8;
}

.btn-approve {
  background: #2ecc71;
  color: #fff;
}

.btn-reject {
  background: rgba(231, 76, 60, 0.1);
  color: #e74c3c;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}
