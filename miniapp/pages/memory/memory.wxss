/* pages/memory/memory.wxss - 记忆中心 */

.page-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 200rpx;
}

/* ========== 层级Tab ========== */
.layer-tabs {
  display: flex;
  white-space: nowrap;
  background: #fff;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.layer-tab {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #f5f6fa;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.layer-tab-active {
  background: #1a73e8;
  color: #fff;
  font-weight: 600;
}

.layer-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.layer-label {
  font-size: 26rpx;
}

/* ========== 搜索栏 ========== */
.search-section {
  background: #fff;
  padding: 16rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.search-toggle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #1a73e8;
  padding: 8rpx 0;
}

.search-icon {
  font-size: 28rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.search-bar-show {
  max-height: 100rpx;
  opacity: 1;
  margin-top: 16rpx;
  padding-bottom: 8rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.search-btn {
  background: #1a73e8;
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* ========== 记忆列表 ========== */
.memory-list {
  padding: 20rpx 30rpx;
}

.memory-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 左侧层级色条 */
.memory-bar {
  width: 8rpx;
  flex-shrink: 0;
}

.memory-bar-long_term {
  background: linear-gradient(180deg, #8e44ad, #9b59b6);
}

.memory-bar-daily {
  background: linear-gradient(180deg, #2980b9, #3498db);
}

.memory-bar-dreams {
  background: linear-gradient(180deg, #f39c12, #f1c40f);
}

.memory-bar-agent {
  background: linear-gradient(180deg, #27ae60, #2ecc71);
}

.memory-content {
  flex: 1;
  padding: 24rpx;
}

/* 标题行 */
.memory-header {
  margin-bottom: 12rpx;
}

.memory-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.memory-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  flex: 1;
  margin-right: 16rpx;
}

.memory-expand-icon {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

.memory-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.memory-source {
  font-size: 22rpx;
  color: #1a73e8;
  font-family: monospace;
}

.memory-date {
  font-size: 22rpx;
  color: #999;
}

/* 标签badges */
.memory-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tag-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #f0f2f5;
  color: #555;
}

.tag-agent {
  background: rgba(46, 204, 113, 0.15);
  color: #27ae60;
  font-weight: 500;
}

/* 内容区域 */
.memory-body {
  overflow: hidden;
  transition: max-height 0.4s ease;
}

.memory-body-collapsed {
  max-height: 100rpx;
  position: relative;
}

.memory-body-collapsed::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(transparent, #fff);
}

.memory-body-expanded {
  max-height: 2000rpx;
}

.memory-rich-content {
  display: none;
}

.memory-raw-content {
  font-size: 26rpx;
  color: #444;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

/* Markdown简化渲染 - 内容区样式 */
.memory-body-expanded .memory-raw-content {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

/* 操作按钮 */
.memory-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  background: #f5f6fa;
  color: #555;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}

/* ========== 统计面板 ========== */
.stats-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.stats-inner {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.stats-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.stats-divider {
  width: 1rpx;
  height: 40rpx;
  background: #eee;
}
