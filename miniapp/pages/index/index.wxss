/* ===== 首页 Dashboard 样式 — cream / sage / ink 设计刷新 =====
   将原 indigo 渐变 hero 替换为白色 envelope 卡片，所有 indigo
   accent 替换成 sage / coral，并把工作流 / 快捷入口的 active 高亮
   改为黑色 ink 圆胶囊，与 web /style-preview 体验对齐。
*/

.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---------- 1. 基金头部卡片 ---------- */
.fund-header {
  background: #ffffff;
  margin: 24rpx 32rpx;
  padding: 36rpx 36rpx 32rpx;
  color: #1f1d18;
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  border: 1rpx solid rgba(229, 227, 221, 0.7);
  box-shadow: 0 4rpx 20rpx rgba(28, 28, 24, 0.06);
}

.fund-header::after {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(158, 201, 154, 0.18);
}

.fund-header::before {
  content: '团队驾驶舱';
  display: block;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  color: #7a766c;
  margin-bottom: 12rpx;
  font-weight: 700;
}

.fund-header-top {
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.fund-name-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.fund-name {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #1f1d18;
}

.mode-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  letter-spacing: 2rpx;
}

.mode-badge--live {
  background: #fad1d3;
  color: #c5343a;
}

.mode-badge--simulation {
  background: #fbe1d1;
  color: #dc6f24;
}

.company-name {
  font-size: 24rpx;
  color: #7a766c;
}

.fund-header-body {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.nav-big {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.1;
  color: #1f1d18;
}

.nav-change-wrap {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.nav-change {
  font-size: 28rpx;
  font-weight: 700;
}

.nav-change-pct {
  font-size: 24rpx;
  font-weight: 600;
}

.color-up {
  color: #c5343a;             /* A 股审美：上涨 = 红 */
}

.color-down {
  color: #1faa64;             /* 下跌 = 绿（sage） */
}

.fund-header-label {
  font-size: 22rpx;
  color: #7a766c;
  position: relative;
  z-index: 1;
}

/* ---------- 2. 快捷指标行 ---------- */
.metrics-row {
  display: flex;
  padding: 24rpx 32rpx 12rpx;
  gap: 16rpx;
  white-space: nowrap;
}

.metrics-row metric-card {
  display: inline-block;
  min-width: 240rpx;
  flex-shrink: 0;
}

/* ---------- 通用 Section ---------- */
.section {
  background: #ffffff;
  margin: 20rpx 32rpx;
  border-radius: 32rpx;
  padding: 32rpx 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(28, 28, 24, 0.06);
  border: 1rpx solid rgba(229, 227, 221, 0.7);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f1d18;
  letter-spacing: 0.5rpx;
}

.section-more {
  font-size: 24rpx;
  color: #0f6a3f;
  font-weight: 600;
}

/* ---------- 3. NAV 走势 ---------- */
.chart-wrap {
  display: flex;
  justify-content: center;
  padding: 8rpx 0;
}

/* ---------- 4. 持仓列表横向滚动 ---------- */
.positions-scroll {
  display: flex;
  gap: 20rpx;
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.position-card {
  display: inline-flex;
  flex-direction: column;
  width: 280rpx;
  min-width: 280rpx;
  background: #faf7f1;
  border-radius: 24rpx;
  padding: 24rpx 22rpx;
  box-shadow: 0 1rpx 8rpx rgba(28, 28, 24, 0.04);
  border: 1rpx solid rgba(229, 227, 221, 0.6);
  gap: 12rpx;
  flex-shrink: 0;
}

.pos-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pos-symbol {
  font-size: 26rpx;
  font-weight: 800;
  color: #1f1d18;
  font-family: monospace;
}

.pos-name {
  font-size: 22rpx;
  color: #7a766c;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pos-mid {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pos-quantity {
  font-size: 22rpx;
  color: #7a766c;
}

.pos-market-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f1d18;
}

.pos-bottom {
  margin-top: 4rpx;
}

.pos-pnl {
  font-size: 28rpx;
  font-weight: 800;
}

/* ---------- 5. 最近交易 ---------- */
.trade-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.trade-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ebe8e1;
}

.trade-row:last-child {
  border-bottom: none;
}

.trade-time {
  font-size: 22rpx;
  color: #7a766c;
  width: 140rpx;
  flex-shrink: 0;
}

.trade-action-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.badge-buy {
  background: #fad1d3;
  color: #c5343a;
}

.badge-sell {
  background: #dcebd6;
  color: #0f6a3f;
}

.trade-symbol {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f1d18;
  font-family: monospace;
  flex-shrink: 0;
}

.trade-quantity {
  font-size: 24rpx;
  color: #7a766c;
  flex: 1;
}

.trade-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f1d18;
  flex-shrink: 0;
}

/* ---------- 6. 工作流状态 ---------- */
.wf-status-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.wf-status--idle {
  background: #ebe8e1;
  color: #7a766c;
}

.wf-status--running {
  background: #dcebd6;
  color: #0f6a3f;
}

.wf-status--completed {
  background: #dcebd6;
  color: #0f6a3f;
}

.workflow-steps {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 0 8rpx;
  margin-bottom: 32rpx;
}

.wf-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  position: relative;
}

/* 连接线 */
.wf-step:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: calc(50% + 14rpx);
  width: calc(100% - 28rpx);
  height: 4rpx;
  background: #ebe8e1;
}

.wf-step--done:not(:last-child)::after {
  background: #1faa64;
}

.wf-step--active:not(:last-child)::after {
  background: linear-gradient(90deg, #1faa64, #ebe8e1);
}

.wf-step-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #ebe8e1;
  border: 4rpx solid #ffffff;
  position: relative;
  z-index: 1;
  transition: all 0.3s;
}

.wf-step--done .wf-step-dot {
  background: #1faa64;
}

.wf-step--active .wf-step-dot {
  background: #1faa64;
  box-shadow: 0 0 0 8rpx rgba(31, 170, 100, 0.20);
}

.wf-step-label {
  font-size: 20rpx;
  color: #b3afa2;
  text-align: center;
  white-space: nowrap;
}

.wf-step--done .wf-step-label,
.wf-step--active .wf-step-label {
  color: #0f6a3f;
  font-weight: 700;
}

.workflow-action {
  display: flex;
  justify-content: center;
}

.wf-btn {
  width: 86%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 999rpx;
  border: none;
  color: #ffffff;
}

.wf-btn--start {
  background: #111110;
  box-shadow: 0 6rpx 18rpx rgba(17, 17, 16, 0.32);
}

.wf-btn--pause {
  background: #f7a05d;
  color: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(247, 160, 93, 0.4);
}

.wf-btn::after {
  border: none;
}

/* ---------- 7. 快捷入口 ---------- */
.shortcuts-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
}

.shortcut-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: #faf7f1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border: 1rpx solid rgba(229, 227, 221, 0.7);
}

.shortcut-label {
  font-size: 24rpx;
  color: #1f1d18;
  font-weight: 600;
  text-align: center;
}

/* ---------- 底部安全区 ---------- */
.safe-bottom {
  height: 40rpx;
}
