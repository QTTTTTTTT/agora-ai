/* ===== 团队管理页面样式 — cream / sage / ink 设计刷新 =====
   原始版本使用了一个紫色 indigo 渐变作为顶部头图；新设计
   保留页面结构（头部统计 + agent 列表 + 底部 CTA + 招聘弹窗），
   但把所有 indigo 替换为：
     - cream 纸面 + sage / coral / risk 色域（参见 app.wxss）
     - 顶部由"白色 envelope-card + section-eyebrow"代替渐变 hero
     - 底部 CTA 用黑胶囊 .btn-ink，浮在 sticky-action-bar 容器内
   这套规则与 web /style-preview 与 Android HomeScreen 完全对齐。
*/

.page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---------- 1. 团队概览头部 ---------- */
.team-overview {
  background: #ffffff;
  margin: 24rpx 32rpx;
  padding: 36rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(229, 227, 221, 0.7);
  box-shadow: 0 4rpx 20rpx rgba(28, 28, 24, 0.06);
  color: #1f1d18;
}

.team-overview::before {
  content: '团队驾驶舱';
  display: block;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  font-weight: 700;
  color: #7a766c;
  margin-bottom: 12rpx;
}

.overview-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.overview-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1f1d18;
}

.overview-count {
  font-size: 48rpx;
  font-weight: 800;
  color: #1faa64;
}

/* 角色分布统计条 */
.role-bar {
  display: flex;
  height: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f4f2ee;
  margin-bottom: 24rpx;
  gap: 2rpx;
}

.role-bar-segment {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.role-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx 22rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #faf7f1;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(229, 227, 221, 0.7);
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-label {
  font-size: 22rpx;
  color: #1f1d18;
  font-weight: 600;
}

.legend-count {
  font-size: 22rpx;
  font-weight: 700;
  color: #7a766c;
}

/* ---------- 2. Agent 列表 ---------- */
.agent-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 32rpx;
}

.agent-item {
  position: relative;
}

.fire-btn {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  background: #fad1d3;
  border: none;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  z-index: 2;
}

.fire-btn-text {
  font-size: 20rpx;
  color: #c5343a;
  font-weight: 700;
}

/* ---------- 底部占位 ---------- */
.bottom-placeholder {
  height: 200rpx;
}

/* ---------- 3. 招聘按钮（固定底部） ---------- */
.hire-btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(244, 242, 238, 0) 0%, #f4f2ee 30%);
  z-index: 10;
}

.hire-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  background: #111110;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 6rpx 18rpx rgba(17, 17, 16, 0.32);
}

.hire-btn::after {
  border: none;
}

/* ---------- 4. 招聘弹窗 ---------- */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(31, 29, 24, 0);
  z-index: 100;
  pointer-events: none;
  transition: background 0.3s ease;
}

.modal-mask--show {
  background: rgba(31, 29, 24, 0.45);
  pointer-events: auto;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 36rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: auto;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-content--show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f1d18;
}

.modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #7a766c;
  background: #f4f2ee;
  border-radius: 50%;
}

.modal-section {
  margin-bottom: 36rpx;
}

.modal-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f1d18;
  display: block;
  margin-bottom: 18rpx;
  letter-spacing: 1rpx;
}

/* 角色 radio */
.role-radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.role-radio-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 26rpx;
  background: #faf7f1;
  border-radius: 999rpx;
  border: 1rpx solid #ebe8e1;
  transition: all 0.2s;
}

.role-radio-item--active {
  background: #dcebd6;
  border-color: #9ec99a;
}

.role-radio-text {
  font-size: 26rpx;
  color: #1f1d18;
  font-weight: 600;
}

/* Picker */
.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 26rpx;
  background: #faf7f1;
  border-radius: 24rpx;
  border: 1rpx solid #ebe8e1;
}

.picker-value {
  font-size: 28rpx;
  color: #1f1d18;
  font-family: monospace;
}

.picker-arrow {
  font-size: 22rpx;
  color: #7a766c;
}

/* 按钮组 */
.modal-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 48rpx;
}

.modal-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 999rpx;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn--cancel {
  background: #f4f2ee;
  color: #1f1d18;
  border: 1rpx solid #ebe8e1;
}

.modal-btn--confirm {
  background: #111110;
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(17, 17, 16, 0.32);
}
