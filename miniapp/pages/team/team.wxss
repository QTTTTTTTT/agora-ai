/* ===== 团队管理页面样式 ===== */

.page {
  background: #f5f6fa;
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---------- 1. 团队概览头部 ---------- */
.team-overview {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  padding: 40rpx 32rpx 36rpx;
  color: #ffffff;
}

.overview-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.overview-title {
  font-size: 36rpx;
  font-weight: 700;
}

.overview-count {
  font-size: 48rpx;
  font-weight: 800;
}

/* 角色分布统计条 */
.role-bar {
  display: flex;
  height: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.2);
  margin-bottom: 20rpx;
  gap: 2rpx;
}

.role-bar-segment {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.role-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.legend-count {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
}

/* ---------- 2. Agent 列表 ---------- */
.agent-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 24rpx;
}

.agent-item {
  position: relative;
}

.fire-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: #fff1f0;
  border: 1rpx solid #ffccc7;
  border-radius: 12rpx;
  padding: 6rpx 20rpx;
  z-index: 2;
}

.fire-btn-text {
  font-size: 20rpx;
  color: #ff4d4f;
  font-weight: 600;
}

/* ---------- 底部占位 ---------- */
.bottom-placeholder {
  height: 160rpx;
}

/* ---------- 3. 招聘按钮（固定底部） ---------- */
.hire-btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 246, 250, 0) 0%, #f5f6fa 20%);
  z-index: 10;
}

.hire-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 50%, #818cf8 100%);
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(99, 102, 241, 0.35);
}

.hire-btn::after {
  border: none;
}

/* ---------- 4. 招聘弹窗 ---------- */

/* 遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 100;
  pointer-events: none;
  transition: background 0.3s ease;
}

.modal-mask--show {
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}

/* 弹窗内容 */
.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: auto;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-content--show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
  background: #f5f5f5;
  border-radius: 50%;
}

.modal-section {
  margin-bottom: 36rpx;
}

.modal-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

/* 角色 radio */
.role-radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.role-radio-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 28rpx;
  background: #f9f9fb;
  border-radius: 16rpx;
  border: 2rpx solid #ececee;
  transition: all 0.2s;
}

.role-radio-item--active {
  background: #eef2ff;
  border-color: #6366f1;
}

.role-radio-text {
  font-size: 28rpx;
  color: #333;
}

/* Picker */
.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f9f9fb;
  border-radius: 16rpx;
  border: 2rpx solid #ececee;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
  font-family: monospace;
}

.picker-arrow {
  font-size: 22rpx;
  color: #999;
}

/* 按钮组 */
.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 48rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn--cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn--confirm {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.3);
}
